local aspectConnection = nil
local function updateAspectRatio()
    if aspectConnection then aspectConnection:Disconnect() aspectConnection = nil end
    if visualSettings.AspectRatio.Enabled and not miscSettings.PanicMode then
        aspectConnection = RunService.RenderStepped:Connect(function()
            Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, visualSettings.AspectRatio.Ratio, 0, 0, 0, 1)
        end)
    end
end

local function updateWorldTime()
    if visualSettings.WorldTime.Enabled and not miscSettings.PanicMode then
        local t = math.clamp(visualSettings.WorldTime.TimeOfDay, 0, 24)
        Lighting.ClockTime = t
        if t > 20 or t < 5 then
            Lighting.Brightness, Lighting.OutdoorAmbient, Lighting.Ambient = 1.5, Color3.fromRGB(80, 80, 120), Color3.fromRGB(40, 40, 60)
        elseif t > 17 then
            Lighting.Brightness, Lighting.OutdoorAmbient, Lighting.Ambient = 2, Color3.fromRGB(150, 120, 100), Color3.fromRGB(100, 80, 70)
        elseif t > 6 then
            Lighting.Brightness, Lighting.OutdoorAmbient, Lighting.Ambient = 2.5, Color3.fromRGB(200, 200, 200), Color3.fromRGB(128, 128, 128)
        else
            Lighting.Brightness, Lighting.OutdoorAmbient, Lighting.Ambient = 1.8, Color3.fromRGB(180, 140, 120), Color3.fromRGB(100, 80, 70)
        end
    else
        Lighting.ClockTime, Lighting.Brightness = 12, 2
        Lighting.OutdoorAmbient, Lighting.Ambient = Color3.fromRGB(128, 128, 128), Color3.fromRGB(0, 0, 0)
    end
end

