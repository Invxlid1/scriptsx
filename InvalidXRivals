local function safeMouseMove(dx, dy)
    if has_mousemoverel then return pcall(mousemoverel, dx, dy) end
    local cam = Workspace.CurrentCamera
    if cam then pcall(function()
        cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(dy * 0.03), math.rad(-dx * 0.03), 0)
    end) end
end

local function safeClick()
    if has_mouse1click then return pcall(mouse1click) end
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        task.wait(0.02)
        VirtualUser:Button1Up(Vector2.new(0, 0))
    end)
end

