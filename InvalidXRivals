local R15_BONES = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" },
    { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" },
    { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" },
    { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" },
    { "RightLowerLeg", "RightFoot" },
}
local R6_BONES = {
    { "Head", "Torso" }, { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
}

local skeletonLines = {}
local function getBoneTable(c)
    if c:FindFirstChild("UpperTorso") then return R15_BONES end
    return R6_BONES
end

local function destroySkeleton(player)
    if skeletonLines[player] then
        for _, l in ipairs(skeletonLines[player]) do pcall(function() l:Remove() end) end
        skeletonLines[player] = nil
    end
end

local function createSkeleton(player)
    if not Drawing_ok or player == Players.LocalPlayer or not player.Character then return end
    destroySkeleton(player)
    local bones = getBoneTable(player.Character)
    local list = {}
    for _ = 1, #bones do
        local l = safeLine()
        l.Thickness = visualSettings.Skeleton.Thickness
        l.Color = visualSettings.Skeleton.Color
        l.Transparency = visualSettings.Skeleton.Transparency
        l.Visible = true
        table.insert(list, l)
    end
    skeletonLines[player] = list
end

local function updateSkeletons()
    if not visualSettings.Skeleton.Enabled or miscSettings.PanicMode or not Drawing_ok then
        for player, _ in pairs(skeletonLines) do destroySkeleton(player) end
        return
    end
    for _, player in Players:GetPlayers() do
        if player ~= Players.LocalPlayer and player.Character then
            if not skeletonLines[player] then createSkeleton(player) end
            local list = skeletonLines[player]
            if list then
                local character = player.Character
                local bones = getBoneTable(character)
                for i, pair in ipairs(bones) do
                    local a = character:FindFirstChild(pair[1])
                    local b = character:FindFirstChild(pair[2])
                    if a and b and list[i] then
                        local posA, onA = Camera:WorldToViewportPoint(a.Position)
                        local posB, onB = Camera:WorldToViewportPoint(b.Position)
                        if onA and onB then
                            pcall(function()
                                list[i].From = Vector2.new(posA.X, posA.Y)
                                list[i].To   = Vector2.new(posB.X, posB.Y)
                                list[i].Color        = visualSettings.Skeleton.Color
                                list[i].Transparency = visualSettings.Skeleton.Transparency
                                list[i].Thickness    = visualSettings.Skeleton.Thickness
                                list[i].Visible      = true
                            end)
                        else
                            pcall(function() list[i].Visible = false end)
                        end
                    elseif list[i] then
                        pcall(function() list[i].Visible = false end)
                    end
                end
            end
        end
    end
end

