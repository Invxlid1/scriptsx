local function createToggle(parent, text, default, callback, key)
    widgetOrder = widgetOrder + 1
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        LayoutOrder = widgetOrder, Parent = parent,
    })

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0), BackgroundTransparency = 1, Text = text,
        TextColor3 = settings.colors.text, Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame,
    })
    reg(lbl, "TextColor3", "text")

    local track = new("TextButton", {
        Size = UDim2.new(0, 42, 0, 22),
        Position = UDim2.new(1, -42, 0.5, -11),
        BackgroundColor3 = default and settings.colors.primary or settings.colors.backgroundLight,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        Parent = frame,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
    local trackStroke = new("UIStroke", {
        Color = settings.colors.border, Thickness = 1, Transparency = 0.5, Parent = track,
    })
    reg(trackStroke, "Color", "border")

    local knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = default and Color3.new(1, 1, 1) or settings.colors.textDark,
        BorderSizePixel = 0, Parent = track,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local checked = default
    track.MouseButton1Click:Connect(function()
        checked = not checked
        local bgTarget = checked and settings.colors.primary or settings.colors.backgroundLight
        local knobTarget = checked and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        local knobColor = checked and Color3.new(1, 1, 1) or settings.colors.textDark

        TweenService:Create(track, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            { BackgroundColor3 = bgTarget }):Play()
        TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            { Position = knobTarget, BackgroundColor3 = knobColor }):Play()

        if callback then callback(checked) end
        if key then SettingsStore:Set(key, checked) end
        notify(text, checked and "Enabled" or "Disabled",
            checked and settings.colors.success or settings.colors.danger, 1.8)
    end)
end

-- Modern minimal slider
local function createSlider(parent, text, min, max, default, unit, callback, key)
    widgetOrder = widgetOrder + 1
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundTransparency = 1,
        LayoutOrder = widgetOrder, Parent = parent,
    })

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -90, 0, 18), BackgroundTransparency = 1, Text = text,
        TextColor3 = settings.colors.text, Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame,
    })
    reg(lbl, "TextColor3", "text")

    local valueLbl = new("TextLabel", {
        Size = UDim2.new(0, 80, 0, 18), Position = UDim2.new(1, -80, 0, 0),
        BackgroundTransparency = 1, Text = tostring(default) .. (unit or ""),
        TextColor3 = settings.colors.primary, Font = Enum.Font.GothamBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right, Parent = frame,
    })
    reg(valueLbl, "TextColor3", "primary")

    local bg = new("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 28),
        BackgroundColor3 = settings.colors.backgroundLight,
        BorderSizePixel = 0, Parent = frame,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bg })
    reg(bg, "BackgroundColor3", "backgroundLight")

    local pct = math.clamp((default - min) / (max - min), 0, 1)
    local fill = new("Frame", {
        Size = UDim2.new(pct, 0, 1, 0), BackgroundColor3 = settings.colors.primary,
        BorderSizePixel = 0, Parent = bg,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
    new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, settings.colors.primary),
            ColorSequenceKeypoint.new(1, lighten(settings.colors.primary, 0.15)),
        }),
        Rotation = 0, Parent = fill,
    })
    reg(fill, "BackgroundColor3", "primary")

    local thumb = new("TextButton", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(pct, -8, 0.5, -8),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        Parent = bg, ZIndex = 2,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = thumb })
    new("UIStroke", { Color = settings.colors.primary, Thickness = 2, Parent = thumb })

    local dragging = false
    local function update(posX)
        local abs, sz = bg.AbsolutePosition.X, bg.AbsoluteSize.X
        local rel = math.clamp(posX - abs, 0, sz)
        local p = rel / sz
        local v = math.floor((min + (max - min) * p) * 100) / 100
        fill.Size = UDim2.new(p, 0, 1, 0)
        thumb.Position = UDim2.new(p, -8, 0.5, -8)
        valueLbl.Text = tostring(v) .. (unit or "")
        if callback then callback(v) end
        if key then SettingsStore:Set(key, v) end
    end

    thumb.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            TweenService:Create(thumb, TweenInfo.new(0.15), {
                Size = UDim2.new(0, 20, 0, 20),
                Position = UDim2.new(thumb.Position.X.Scale, -10, 0.5, -10),
            }):Play()
            update(i.Position.X)
        end
    end)
    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                TweenService:Create(thumb, TweenInfo.new(0.15), {
                    Size = UDim2.new(0, 16, 0, 16),
                    Position = UDim2.new(thumb.Position.X.Scale, -8, 0.5, -8),
                }):Play()
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end)
end

local function createKeybind(parent, text, defaultKey, callback, key)
    widgetOrder = widgetOrder + 1
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1,
        LayoutOrder = widgetOrder, Parent = parent,
    })

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -115, 1, 0), BackgroundTransparency = 1, Text = text,
        TextColor3 = settings.colors.text, Font = Enum.Font.Gotham, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame,
    })
    reg(lbl, "TextColor3", "text")

    local function keyText(k)
        if not k then return "None" end
        if k == Enum.UserInputType.MouseButton2 then return "RMB" end
        if k == Enum.UserInputType.Touch then return "Touch" end
        if typeof(k) == "EnumItem" then return k.Name end
        return "None"
    end

    local btn = new("TextButton", {
        Size = UDim2.new(0, 100, 0, 30), Position = UDim2.new(1, -100, 0.5, -15),
        BackgroundColor3 = settings.colors.backgroundLight,
        BorderSizePixel = 0, Text = keyText(defaultKey),
        TextColor3 = settings.colors.primary, Font = Enum.Font.GothamBold, TextSize = 12,
        AutoButtonColor = false, Parent = frame,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = btn })
    local bStroke = new("UIStroke", { Color = settings.colors.border, Thickness = 1, Transparency = 0.4, Parent = btn })
    reg(btn, "TextColor3", "primary")
    reg(btn, "BackgroundColor3", "backgroundLight")
    reg(bStroke, "Color", "border")

    local waiting = false
    btn.MouseButton1Click:Connect(function()
        waiting = true
        btn.Text = "..."
        btn.TextColor3 = settings.colors.text
    end)
    UserInputService.InputBegan:Connect(function(i, gp)
        if gp then return end
        if waiting then
            waiting = false
            local nk = nil
            if i.KeyCode ~= Enum.KeyCode.Unknown then nk = i.KeyCode
            elseif i.UserInputType == Enum.UserInputType.MouseButton2 then nk = Enum.UserInputType.MouseButton2
            elseif i.UserInputType == Enum.UserInputType.Touch then nk = Enum.UserInputType.Touch
            else return end
            btn.Text = keyText(nk)
            btn.TextColor3 = settings.colors.primary
            if callback then callback(nk) end
            if key then SettingsStore:Set(key, nk) end
        end
    end)
end

