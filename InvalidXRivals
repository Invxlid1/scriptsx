local CustomThemes = {}
local function loadCustomThemes()
    local ok, data = pcall(readfile, "InvalidX_Themes.json")
    if not (ok and data and data ~= "") then return end
    local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, data)
    if not (ok2 and type(decoded) == "table") then return end
    for name, theme in pairs(decoded) do
        CustomThemes[name] = {}
        for k, v in pairs(theme) do
            CustomThemes[name][k] = (type(v) == "table") and tableToColor(v) or v
        end
    end
end

local function saveCustomThemes()
    local out = {}
    for name, theme in pairs(CustomThemes) do
        out[name] = {}
        for k, v in pairs(theme) do
            out[name][k] = (typeof(v) == "Color3") and colorToTable(v) or v
        end
    end
    pcall(function() writefile("InvalidX_Themes.json", HttpService:JSONEncode(out)) end)
end
loadCustomThemes()

