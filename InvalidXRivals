local function colorSlider(text, key)
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1,
        LayoutOrder = widgetOrder + 1, Parent = themesPage,
    })
    widgetOrder = widgetOrder + 1

    new("TextLabel", {
        Size = UDim2.new(0, 90, 0, 18), BackgroundTransparency = 1, Text = text,
        TextColor3 = settings.colors.text, Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = frame,
    })
    local preview = new("Frame", {
        Size = UDim2.new(0, 30, 0, 18), Position = UDim2.new(1, -40, 0, 0),
        BackgroundColor3 = customThemeData[key], BorderSizePixel = 0, Parent = frame,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 5), Parent = preview })
    new("UIStroke", { Color = settings.colors.border, Thickness = 1, Transparency = 0.5, Parent = preview })

    local valueLbl = new("TextLabel", {
        Size = UDim2.new(0, 55, 0, 18), Position = UDim2.new(1, -100, 0, 0),
        BackgroundTransparency = 1, Text = "", TextColor3 = settings.colors.textDark,
        Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Parent = frame,
    })

    local bar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0, 28),
        BackgroundColor3 = settings.colors.backgroundLight, BorderSizePixel = 0, Parent = frame,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })

    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = customThemeData[key],
        BorderSizePixel = 0, Parent = bar,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

    local dragging = false
    local function update(x)
        local abs, sz = bar.AbsolutePosition.X, bar.AbsoluteSize.X
        local rel = math.clamp(x - abs, 0, sz)
        local p = rel / sz
        local r, g, b = customThemeData[key].R, customThemeData[key].G, customThemeData[key].B
        local maxC = math.max(r, g, b)
        local nr, ng, nb = r, g, b
        if maxC > 0 then nr, ng, nb = (r / maxC) * p, (g / maxC) * p, (b / maxC) * p
        else nr, ng, nb = p, p, p end
        customThemeData[key] = Color3.new(nr, ng, nb)
        fill.Size = UDim2.new(p, 0, 1, 0)
        preview.BackgroundColor3 = customThemeData[key]
        fill.BackgroundColor3 = customThemeData[key]
        valueLbl.Text = string.format("%d,%d,%d", math.floor(nr*255), math.floor(ng*255), math.floor(nb*255))
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true update(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end)
end

