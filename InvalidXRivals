UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == settings.toggleKey and not miscSettings.PanicMode then
        isOpen = not isOpen
        if isOpen then openGui() else closeGui() end
    end

    if not miscSettings.PanicMode then
        local function matches(kb, inp)
            if not kb or typeof(kb) ~= "EnumItem" then return false end
            if kb.EnumType == Enum.KeyCode then return inp.KeyCode == kb end
            if kb.EnumType == Enum.UserInputType then return inp.UserInputType == kb end
            return false
        end
        if matches(aimbotSettings.ToggleKey, input) then
            aimbotSettings.Enabled = not aimbotSettings.Enabled
            SettingsStore:Set("AimbotEnabled", aimbotSettings.Enabled)
            pcall(function() AimbotFOVCircle.Visible = aimbotSettings.ShowFOVCircle and aimbotSettings.Enabled end)
            notify("Aimbot", aimbotSettings.Enabled and "Enabled" or "Disabled",
                aimbotSettings.Enabled and settings.colors.success or settings.colors.danger, 2)
        end
        if matches(triggerSettings.ToggleKey, input) then
            triggerSettings.Enabled = not triggerSettings.Enabled
            SettingsStore:Set("TriggerEnabled", triggerSettings.Enabled)
            pcall(function() TriggerFOVCircle.Visible = triggerSettings.ShowFOV and triggerSettings.Enabled end)
            notify("Triggerbot", triggerSettings.Enabled and "Enabled" or "Disabled",
                triggerSettings.Enabled and settings.colors.success or settings.colors.danger, 2)
        end
    end
end)

--=====================================================================
--  MAIN LOOP (optimized)
--=====================================================================
local lastTriggerCheck = 0
local lastSkelUpdate = 0
local lastHealthUpdate = 0
local lastNametagScan = 0

RunService.RenderStepped:Connect(function()
    if miscSettings.PanicMode then return end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local now = tick()

    -- FOV circles
    if aimbotSettings.ShowFOVCircle and aimbotSettings.Enabled then
        pcall(function()
            AimbotFOVCircle.Position = center
            AimbotFOVCircle.Visible = true
            AimbotFOVCircle.Radius = aimbotSettings.FOV
            AimbotFOVCircle.Color = settings.colors.primary
        end)
    else
        pcall(function() AimbotFOVCircle.Visible = false end)
    end

    if triggerSettings.ShowFOV and triggerSettings.Enabled then
        pcall(function()
            TriggerFOVCircle.Position = center
            TriggerFOVCircle.Visible = true
            TriggerFOVCircle.Radius = triggerSettings.FOV
            TriggerFOVCircle.Color = settings.colors.accent
        end)
    else
        pcall(function() TriggerFOVCircle.Visible = false end)
    end

    -- AIMBOT
    if aimbotSettings.Enabled then
        local pressed = false
        if aimbotSettings.AimKey and typeof(aimbotSettings.AimKey) == "EnumItem" then
            if aimbotSettings.AimKey.EnumType == Enum.KeyCode then
                pressed = UserInputService:IsKeyDown(aimbotSettings.AimKey)
            elseif aimbotSettings.AimKey.EnumType == Enum.UserInputType then
                if aimbotSettings.AimKey == Enum.UserInputType.Touch then
                    local ok, t = pcall(function() return UserInputService:GetTouches() end)
                    pressed = ok and t and #t > 0 or false
                else
                    pcall(function() pressed = UserInputService:IsMouseButtonPressed(aimbotSettings.AimKey) end)
                end
            end
        end

        if pressed then
            local t = GetClosest(center)
            if t and t.Character then
                local head = t.Character:FindFirstChild("Head")
                if head then
                    local hp = head.Position
                    if aimbotSettings.Predict > 0 then
                        local r = t.Character:FindFirstChild("HumanoidRootPart")
                        if r then hp = hp + r.Velocity * aimbotSettings.Predict end
                    end
                    local pos, onScr = Camera:WorldToViewportPoint(hp)
                    if onScr then
                        local dx = pos.X - center.X
                        local dy = pos.Y - center.Y
                        if math.sqrt(dx * dx + dy * dy) > 2 then
                            local s = math.max(aimbotSettings.Smoothness, 1)
                            local mX, mY = dx / s, dy / s
                            local mag = math.sqrt(mX * mX + mY * mY)
                            if mag > 60 then
                                local sc = 60 / mag
                                mX, mY = mX * sc, mY * sc
                            end
                            safeMouseMove(mX, mY)
                        end
                    end
                end
            end
        end
    end

    -- Triggerbot (throttled to 30Hz)
    if triggerSettings.Enabled and (now - lastTriggerCheck) > 0.033 then
        lastTriggerCheck = now
        if IsEnemyInCrosshair(center) then
            local d = triggerSettings.Delay
            if triggerSettings.RandomDelay then
                d = math.random(math.floor(triggerSettings.MinDelay * 1000),
                                math.floor(triggerSettings.MaxDelay * 1000)) / 1000
            end
            if d > 0 then task.wait(d) end
            if IsEnemyInCrosshair(center) then safeClick() end
        end
    end

    -- Tracers
    if visualSettings.Tracers.Enabled and Drawing_ok then
        for player, tr in pairs(tracers) do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local pos, onScr = Camera:WorldToViewportPoint(root.Position)
                if onScr then
                    pcall(function()
                        tr.From = Vector2.new(center.X, center.Y)
                        tr.To   = Vector2.new(pos.X, pos.Y)
                        tr.Color = settings.colors.primary
                        tr.Visible = true
                    end)
                else
                    pcall(function() tr.Visible = false end)
                end
            else
                pcall(function() tr.Visible = false end)
            end
        end
    end

    -- Skeleton (throttled)
    if (now - lastSkelUpdate) > 0.033 then
        lastSkelUpdate = now
        updateSkeletons()
    end

    -- Health ESP (throttled)
    if (now - lastHealthUpdate) > 0.05 then
        lastHealthUpdate = now
        updateHealthESP()
    end

    -- Nametag scan (throttled)
    if visualSettings.NameTags.Enabled and (now - lastNametagScan) > 0.2 then
        lastNametagScan = now
        for _, p in Players:GetPlayers() do
            if p ~= Players.LocalPlayer and not nameTags[p]
                and p.Character and p.Character:FindFirstChild("Head") then
                createNameTag(p)
            end
        end
    end
end)

