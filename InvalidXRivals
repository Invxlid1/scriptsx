local function new(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

local function tableCount(t)
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end

local function colorToTable(c) return { math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255) } end
local function tableToColor(t)
    if type(t) ~= "table" then return Color3.fromRGB(139, 92, 246) end
    return Color3.fromRGB(t[1] or 139, t[2] or 92, t[3] or 246)
end

local function lighten(c, amt)
    return Color3.new(math.min(c.R + amt, 1), math.min(c.G + amt, 1), math.min(c.B + amt, 1))
end
local function darken(c, amt)
    return Color3.new(math.max(c.R - amt, 0), math.max(c.G - amt, 0), math.max(c.B - amt, 0))
end

