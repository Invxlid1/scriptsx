--=====================================================================
--  AIMBOT / TRIGGERBOT LOGIC
--=====================================================================
local function IsVisible(part, wallCheck)
    if not wallCheck then return true end
    local ok, ray = pcall(function()
        return Workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, getRayParams())
    end)
    if not ok then return true end
    return not ray or ray.Instance:IsDescendantOf(part.Parent)
end

local function IsTargetValid(player, teamCheck)
    if player == Players.LocalPlayer or not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if teamCheck then
        local lp = Players.LocalPlayer
        if lp.Team and player.Team and lp.Team == player.Team then return false end
    end
    return true
end

local function GetClosest(center)
    local closest, dist = nil, math.huge
    for _, plr in Players:GetPlayers() do
        if IsTargetValid(plr, aimbotSettings.TeamCheck) and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local pos, onScr = Camera:WorldToViewportPoint(head.Position)
                if onScr then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < aimbotSettings.FOV and d < dist and IsVisible(head, aimbotSettings.WallCheck) then
                        dist, closest = d, plr
                    end
                end
            end
        end
    end
    return closest
end

local function IsEnemyInCrosshair(center)
    for _, plr in Players:GetPlayers() do
        if IsTargetValid(plr, triggerSettings.TeamCheck) and plr.Character then
            for _, name in ipairs({ "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Torso" }) do
                local part = plr.Character:FindFirstChild(name)
                if part then
                    local pos, onScr = Camera:WorldToViewportPoint(part.Position)
                    if onScr then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d <= triggerSettings.FOV and IsVisible(part, triggerSettings.WallCheck) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

