local function onCharAdded(ch)
    local p = Players:GetPlayerFromCharacter(ch)
    if p and p ~= Players.LocalPlayer and not miscSettings.PanicMode then
        task.wait(0.4)
        if visualSettings.ESP.Enabled and not highlights[p] then createHighlight(p) end
        if visualSettings.NameTags.Enabled and not nameTags[p] then createNameTag(p) end
        if visualSettings.HealthESP.Enabled and not healthESPs[p] then createHealthESP(p) end
    end
end

local function onCharRemoving(ch)
    local p = Players:GetPlayerFromCharacter(ch)
    if p and p ~= Players.LocalPlayer then
        if highlights[p] then pcall(function() highlights[p]:Destroy() end) highlights[p] = nil end
        if nameTags[p] and nameTags[p].billboard then pcall(function() nameTags[p].billboard:Destroy() end) nameTags[p] = nil end
        if healthESPs[p] and healthESPs[p].billboard then pcall(function() healthESPs[p].billboard:Destroy() end) healthESPs[p] = nil end
        destroySkeleton(p)
    end
end

for _, p in Players:GetPlayers() do
    if p ~= Players.LocalPlayer then
        p.CharacterAdded:Connect(onCharAdded)
        p.CharacterRemoving:Connect(onCharRemoving)
    end
end

Players.PlayerAdded:Connect(function(p)
    if p ~= Players.LocalPlayer then
        p.CharacterAdded:Connect(onCharAdded)
        p.CharacterRemoving:Connect(onCharRemoving)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if tracers[p] then pcall(function() tracers[p]:Remove() end) tracers[p] = nil end
    if highlights[p] then pcall(function() highlights[p]:Destroy() end) highlights[p] = nil end
    if nameTags[p] and nameTags[p].billboard then pcall(function() nameTags[p].billboard:Destroy() end) nameTags[p] = nil end
    if healthESPs[p] and healthESPs[p].billboard then pcall(function() healthESPs[p].billboard:Destroy() end) healthESPs[p] = nil end
    destroySkeleton(p)
end)

