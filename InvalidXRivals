local SettingsStore = { Data = {}, FileName = "InvalidX_Settings.json", _savePending = false }

function SettingsStore:Load()
    local ok, data = pcall(readfile, self.FileName)
    if ok and data and data ~= "" then
        local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, data)
        self.Data = ok2 and decoded or {}
    else
        self.Data = {}
    end
end
function SettingsStore:_flush()
    self._savePending = false
    pcall(function() writefile(self.FileName, HttpService:JSONEncode(self.Data)) end)
end
function SettingsStore:Save()
    if self._savePending then return end
    self._savePending = true
    task.delay(0.8, function() if self._savePending then self:_flush() end end)
end
function SettingsStore:ForceFlush() if self._savePending then self:_flush() end end

function SettingsStore:Get(key, default)
    if key:find("Key") then
        local s = self.Data[key]
        if s then
            if s == "MouseButton2" then return Enum.UserInputType.MouseButton2 end
            if s == "Touch" then return Enum.UserInputType.Touch end
            local et, en = s:match("Enum%.(%w+)%.(%w+)")
            if et and en and Enum[et] and Enum[et][en] then return Enum[et][en] end
        end
        return default
    end
    return self.Data[key] ~= nil and self.Data[key] or default
end

function SettingsStore:Set(key, value)
    if value == nil then self.Data[key] = nil
    elseif typeof(value) == "EnumItem" then self.Data[key] = tostring(value)
    else self.Data[key] = value end
    self:Save()
end

