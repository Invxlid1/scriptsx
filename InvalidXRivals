        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "100/100", TextColor3 = Color3.fromRGB(16, 185, 129),
        TextScaled = true, Font = Enum.Font.GothamBold,
        TextStrokeTransparency = visualSettings.HealthESP.Outline and 0.4 or 1, Parent = bb,
    })
    healthESPs[player] = { billboard = bb, label = label, humanoid = humanoid, lastText = "" }
end

local function updateHealthESP()
    for player, esp in pairs(healthESPs) do
        if esp.humanoid and esp.humanoid.Parent and esp.label then
            local h, mh = math.floor(esp.humanoid.Health), math.floor(esp.humanoid.MaxHealth)
            local newText = h .. "/" .. mh
            if esp.lastText ~= newText then
                esp.lastText = newText
                esp.label.Text = newText
                local p = esp.humanoid.Health / esp.humanoid.MaxHealth
                if p > 0.6 then esp.label.TextColor3 = Color3.fromRGB(16, 185, 129)
                elseif p > 0.3 then esp.label.TextColor3 = Color3.fromRGB(250, 204, 21)
                else esp.label.TextColor3 = Color3.fromRGB(239, 68, 68) end
            end
        else
            if esp.billboard then pcall(function() esp.billboard:Destroy() end) end
            healthESPs[player] = nil
        end
    end
    if visualSettings.HealthESP.Enabled and not miscSettings.PanicMode then
        for _, player in Players:GetPlayers() do
            if player ~= Players.LocalPlayer and not healthESPs[player]
                and player.Character and player.Character:FindFirstChild("Head") then
                createHealthESP(player)
            end
        end
    else
        for p, esp in pairs(healthESPs) do
            if esp.billboard then pcall(function() esp.billboard:Destroy() end) end
            healthESPs[p] = nil
        end
    end
end

local tracers = {}
local function updateTracers()
    for _, player in Players:GetPlayers() do
        if player ~= Players.LocalPlayer then
            if visualSettings.Tracers.Enabled and not miscSettings.PanicMode and Drawing_ok then
