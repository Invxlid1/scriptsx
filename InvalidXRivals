local highlights = {}
local function createHighlight(player)
    if player == Players.LocalPlayer or not player.Character then return end
    local existing = player.Character:FindFirstChild("InvalidX_ESP")
    if existing then existing:Destroy() end
    local h = Instance.new("Highlight")
    h.Name = "InvalidX_ESP"
    h.FillColor = visualSettings.ESP.Color
    h.FillTransparency = visualSettings.ESP.FillTransparency
    h.OutlineColor = visualSettings.ESP.Color
    h.OutlineTransparency = visualSettings.ESP.Transparency
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee = player.Character
    h.Parent = player.Character
    highlights[player] = h
end

local function updateESP()
    for _, player in Players:GetPlayers() do
        if player ~= Players.LocalPlayer then
            if visualSettings.ESP.Enabled and not miscSettings.PanicMode then
                if not highlights[player] and player.Character then
                    createHighlight(player)
                elseif highlights[player] then
                    highlights[player].FillColor = visualSettings.ESP.Color
                    highlights[player].FillTransparency = visualSettings.ESP.FillTransparency
                    highlights[player].OutlineColor = visualSettings.ESP.Color
                    highlights[player].OutlineTransparency = visualSettings.ESP.Transparency
                end
            elseif highlights[player] then
                pcall(function() highlights[player]:Destroy() end)
                highlights[player] = nil
            end
        end
    end
end

