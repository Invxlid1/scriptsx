local ThemeRegistry = {}
local function reg(el, prop, role)
    table.insert(ThemeRegistry, { el = el, prop = prop, role = role })
    return el
end

local function applyTheme(themeName, animate)
    local theme = getThemeByName(themeName)
    activeThemeName = themeName
    SettingsStore:Set("ActiveTheme", themeName)
    settings.colors = theme
    local dur = animate and 0.4 or 0
    for _, e in ipairs(ThemeRegistry) do
        if e.el and e.el.Parent then
            local target = theme[e.role]
            if typeof(target) == "Color3" then
                if dur > 0 then
                    pcall(function()
                        TweenService:Create(e.el, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                            { [e.prop] = target }):Play()
                    end)
                else
                    pcall(function() e.el[e.prop] = target end)
                end
            end
        end
    end
end

