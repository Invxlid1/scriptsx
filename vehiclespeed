    elseif camMode=="First Person"then cam.CoordinateFrame=CFrame.new(pos+Vector3.new(0,2.6,0),pos+look)
    elseif camMode=="Cinematic"then cam.CoordinateFrame=CFrame.new(pos-look*15+Vector3.new(0,7.5,0)+right*4.5,pos)
    elseif camMode=="Drone View"then cam.CoordinateFrame=CFrame.new(pos-look*21+Vector3.new(0,16,0),pos)
    elseif camMode=="Low Angle"then cam.CoordinateFrame=CFrame.new(pos-look*11+Vector3.new(0,1.5,0),pos)
    elseif camMode=="High Angle"then cam.CoordinateFrame=CFrame.new(pos-look*14+Vector3.new(0,13,0),pos)
    elseif camMode=="Side View Left"then cam.CoordinateFrame=CFrame.new(pos-right*16+Vector3.new(0,6,0),pos)
    elseif camMode=="Side View Right"then cam.CoordinateFrame=CFrame.new(pos+right*16+Vector3.new(0,6,0),pos)
    elseif camMode=="Orbit Slow"then local o=Vector3.new(math.cos(time*.8)*16,6,math.sin(time*.8)*16) cam.CoordinateFrame=CFrame.new(pos+o,pos)
    elseif camMode=="Orbit Fast"then local o=Vector3.new(math.cos(time*2.2)*14,5,math.sin(time*2.2)*14) cam.CoordinateFrame=CFrame.new(pos+o,pos)
    elseif camMode=="Bumper Cam"then cam.CoordinateFrame=CFrame.new(pos+look*2.5+Vector3.new(0,1.2,0),pos+look)
    elseif camMode=="Far Chase"then cam.CoordinateFrame=CFrame.new(pos-look*28+Vector3.new(0,8,0),pos)
    elseif camMode=="Flying Cam"then cam.CoordinateFrame=CFrame.new(pos-look*19+Vector3.new(0,14,0)+right*math.sin(time)*6,pos)
    elseif camMode=="Stunt Cam"then cam.CoordinateFrame=CFrame.new(pos-look*10+Vector3.new(0,8,0),pos)*CFrame.Angles(math.rad(math.sin(time*3)*4),0,0)
    elseif camMode=="Cockpit"then cam.CoordinateFrame=CFrame.new(pos+look*1.2+Vector3.new(0,2.2,0),pos+look)
    else cam.CoordinateFrame=CFrame.new(pos-look*11+Vector3.new(0,5,0),pos) end
end)

