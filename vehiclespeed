local function IsBlocked(part,veh)
    if not part or not part:IsA("BasePart")then return false end
    if veh and part:IsDescendantOf(veh)then return false end
    if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character)then return false end
    if aiTargetPlayer and aiTargetPlayer.Character and part:IsDescendantOf(aiTargetPlayer.Character)then return false end
    return part.CanCollide
end
local function CheckBox(veh,offset,size)
    local pvt=veh:GetPivot()
    for _,pt in ipairs(Workspace:GetPartBoundsInBox(pvt*CFrame.new(offset),size,overlapParams))do
        if IsBlocked(pt,veh)then return true end
    end return false
end
local function CheckRay(veh,offset,dir,dist)
    local pvt=veh:GetPivot()
    local res=Workspace:Raycast((pvt*CFrame.new(offset)).Position,dir.Unit*dist,rayParams)
    return res and IsBlocked(res.Instance,veh)
end

RunService.Heartbeat:Connect(function(dt)
    local hum=GetHumanoid()
    if not aiEnabled then if hum then hum.AutoRotate=aiSavedRot end ClearTracer()return end
    if flightEnabled then ClearTracer()return end
    if not hum or not hum.SeatPart or not hum.SeatPart:IsA("VehicleSeat")then ClearTracer()return end
    local seat,veh=GetSeatAndVehicle()
    if not seat or not veh or not veh.PrimaryPart then ClearTracer()return end
    hum.AutoRotate=false
    overlapParams.FilterDescendantsInstances={LocalPlayer.Character,veh}
    rayParams.FilterDescendantsInstances={LocalPlayer.Character,veh}
    local pvt=veh:GetPivot() local vehPos=veh.PrimaryPart.Position
    local _,size=veh:GetBoundingBox()
    local wd,ln,ht=math.max(size.X,4),math.max(size.Z,6),math.max(size.Y,4)
    local forward=Vector3.new(pvt.LookVector.X,0,pvt.LookVector.Z).Unit
    local right=Vector3.new(pvt.RightVector.X,0,pvt.RightVector.Z)
    right=right.Magnitude>.001 and right.Unit or Vector3.xAxis
    local spd=veh.PrimaryPart.AssemblyLinearVelocity.Magnitude
    local lookFwd=math.clamp(aiLookAhead+spd*.25,25,120)
    local lookSide=math.clamp(aiSideRange+spd*.12,18,90)
    local goalDir,goalDist=nil,nil
    if aiTargetEnabled and aiTargetPlayer and aiTargetPlayer.Character then
        local root=aiTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            UpdateTracer(vehPos+Vector3.new(0,2.5,0),root.Position+Vector3.new(0,2.5,0))
            local diff=root.Position-vehPos
            goalDist=Vector3.new(diff.X,0,diff.Z).Magnitude
            if goalDist>3 then goalDir=Vector3.new(diff.X,0,diff.Z).Unit end
            if goalDist and goalDist<9 then veh.PrimaryPart.AssemblyLinearVelocity*=.55 goalDir=nil end
        end
    else ClearTracer()end
    local blockedFwd=CheckBox(veh,Vector3.new(0,0,-lookFwd*.35),Vector3.new(wd*.9,ht*.85,lookFwd*.55))
        or CheckRay(veh,Vector3.new(0,ht*.5,-ln*.45),-Vector3.zAxis,lookFwd)
    local blockedL=CheckBox(veh,Vector3.new(-wd*.8,0,-lookSide*.25),Vector3.new(wd*.85,ht*.85,lookSide*.5))
        or CheckRay(veh,Vector3.new(-wd*.35,ht*.5,-ln*.35),Vector3.new(-1,0,0),lookSide)
    local blockedR=CheckBox(veh,Vector3.new(wd*.8,0,-lookSide*.25),Vector3.new(wd*.85,ht*.85,lookSide*.5))
        or CheckRay(veh,Vector3.new(wd*.35,ht*.5,-ln*.35),Vector3.new(1,0,0),lookSide)
    if aiLastPos then aiStuckTime=(vehPos-aiLastPos).Magnitude<.08 and spd<7 and(aiStuckTime+dt)or math.max(0,aiStuckTime-dt*2)end
    aiLastPos=vehPos
    if aiStuckTime>1.2 and aiState~="REVERSE"then aiState="REVERSE" aiRevTime=0 aiTurnDir=not blockedL and-1 or 1 end
    if aiState=="FORWARD"and blockedFwd then aiState="AVOID"
    elseif aiState=="AVOID"and not blockedFwd then aiState="FORWARD"
    elseif aiState=="AVOID"and blockedL and blockedR then aiState="REVERSE" aiRevTime=0
    elseif aiState=="REVERSE"then aiRevTime+=dt
        if aiRevTime>.85 and not blockedL and not blockedR then aiState="AVOID" aiRevTime=0 aiStuckTime=0
        elseif aiRevTime>3.2 then aiTurnDir=not blockedL and-1 or 1 aiState="RECOVER" aiRevTime=0 end
    elseif aiState=="RECOVER"and not blockedFwd then aiState="FORWARD" aiStuckTime=0 end
    local dir=forward local speed=aiSpeed
    if goalDir and not blockedFwd then dir=goalDir if goalDist and goalDist<50 then speed=aiSpeed*math.clamp(goalDist/50,.35,1) end
    elseif aiState=="AVOID"then aiTurnDir=not blockedL and-1 or not blockedR and 1 or aiTurnDir dir=(forward+right*aiTurnDir*1.35).Unit speed=aiSpeed*(blockedFwd and .45 or .7)
    elseif aiState=="REVERSE"then dir=(-forward+right*aiTurnDir*.55).Unit speed=math.min(aiSpeed*.32,50)
    elseif aiState=="RECOVER"then dir=(forward+right*aiTurnDir*1.8).Unit speed=math.min(aiSpeed*.45,60) end
    local flat=Vector3.new(dir.X,0,dir.Z).Unit
    if flat.Magnitude>.001 then veh:PivotTo(pvt:Lerp(CFrame.lookAt(pvt.Position,pvt.Position+flat,Vector3.yAxis),math.clamp(dt*aiTurnStr,0,1)))end
    local moveDir=Vector3.new(veh.PrimaryPart.CFrame.LookVector.X,0,veh.PrimaryPart.CFrame.LookVector.Z)
    moveDir=moveDir.Magnitude>.001 and moveDir.Unit or forward
    if aiState=="REVERSE"and not goalDir then moveDir=-moveDir end
    local targetVel=moveDir*speed local resp=math.clamp(dt*(6+math.clamp(aiSpeed/100,0,2)),0,1) local curVel=veh.PrimaryPart.AssemblyLinearVelocity
    veh.PrimaryPart.AssemblyLinearVelocity=Vector3.new(curVel.X+(targetVel.X-curVel.X)*resp,curVel.Y,curVel.Z+(targetVel.Z-curVel.Z)*resp)
    veh.PrimaryPart.AssemblyAngularVelocity=Vector3.new(0,veh.PrimaryPart.AssemblyAngularVelocity.Y*.2,0)
end)

