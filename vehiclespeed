local function AlignPlayerToVehicle(veh)
    local char=LocalPlayer.Character local hum=GetHumanoid()
    local root=char and char:FindFirstChild("HumanoidRootPart") local prim=veh and veh.PrimaryPart
    if not root or not hum or not prim then return end
    local forward=Vector3.new(prim.CFrame.LookVector.X,0,prim.CFrame.LookVector.Z)
    if forward.Magnitude<.001 then return end
    root.CFrame=CFrame.lookAt(root.Position,root.Position+forward.Unit,Vector3.yAxis)
end

RunService.Stepped:Connect(function(_,dt)
    local hum=GetHumanoid()
    if not flightEnabled then if flightWasActive and hum then hum.AutoRotate=savedAutoRotate end flightWasActive=false return end
    flightWasActive=true
    if not hum or not hum.SeatPart or not hum.SeatPart:IsA("VehicleSeat")then return end
    local seat,veh=GetSeatAndVehicle()
    if not seat or not veh or not veh.PrimaryPart then return end
    hum.AutoRotate=false
    local cam=Workspace.CurrentCamera
    local forward=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
    local right=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
    if forward.Magnitude<.001 then forward=Vector3.new(veh.PrimaryPart.CFrame.LookVector.X,0,veh.PrimaryPart.CFrame.LookVector.Z) else forward=forward.Unit end
    if right.Magnitude>.001 then right=right.Unit end
    local move=Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W)then move+=forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S)then move-=forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.D)then move+=right end
    if UserInputService:IsKeyDown(Enum.KeyCode.A)then move-=right end
    if UserInputService:IsKeyDown(Enum.KeyCode.E)then move+=Vector3.yAxis*flightVertical end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q)then move-=Vector3.yAxis*flightVertical end
    local horiz=Vector3.new(move.X,0,move.Z)
    if horiz.Magnitude>.001 then
        horiz=horiz.Unit
        local targetCF=CFrame.lookAt(veh.PrimaryPart.Position,veh.PrimaryPart.Position+horiz,Vector3.yAxis)
        veh:PivotTo(veh:GetPivot():Lerp(targetCF,math.clamp(dt*flightSmooth,0,1)))
    end
    veh.PrimaryPart.AssemblyLinearVelocity=veh.PrimaryPart.AssemblyLinearVelocity:Lerp(move*(flightSpeed*100),math.clamp(dt*12,0,1))
    veh.PrimaryPart.AssemblyAngularVelocity=Vector3.zero
    AlignPlayerToVehicle(veh)
end)

