local function SetZeroGravityState(state)
    zeroGravity=state
    Workspace.Gravity=state and 0 or DEFAULT_GRAVITY
    local _,veh=GetSeatAndVehicle()
    if veh then
        for _,d in ipairs(veh:GetDescendants())do
            if d:IsA("BasePart")then
                d.GravityScale=state and 0 or 1
            end
        end
    end
end

