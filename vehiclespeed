local function PushVehicleUp(pushForce,forwardBoost,rotX,rotY,rotZ)
    local _,veh=GetSeatAndVehicle()
    if not veh or not veh.PrimaryPart then return end
    local prim=veh.PrimaryPart
    local fwd=Vector3.new(prim.CFrame.LookVector.X,0,prim.CFrame.LookVector.Z).Unit
    if fwd.Magnitude<.01 then fwd=Vector3.new(0,0,1) end
    prim.AssemblyLinearVelocity += Vector3.new(0, pushForce, 0) + fwd * (forwardBoost or 0)
    if rotX or rotY or rotZ then
        prim.AssemblyAngularVelocity += Vector3.new(rotX or 0, rotY or 0, rotZ or 0)
    end
end

