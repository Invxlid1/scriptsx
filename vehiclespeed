local function GetHumanoid()return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")end
local function GetVehicleFromDescendant(desc)
    if not desc then return nil end
    return desc:FindFirstAncestor(LocalPlayer.Name.."'s Car")
        or (desc:FindFirstAncestor("Body")and desc:FindFirstAncestor("Body").Parent or nil)
        or (desc:FindFirstAncestor("Misc")and desc:FindFirstAncestor("Misc").Parent or nil)
        or desc:FindFirstAncestorWhichIsA("Model")
end
local function GetSeatAndVehicle()
    local hum=GetHumanoid()
    if not hum or not hum.SeatPart or not hum.SeatPart:IsA("VehicleSeat")then return nil,nil end
    local seat=hum.SeatPart
    local veh=GetVehicleFromDescendant(seat)
    if not veh then return nil,nil end
    if not veh.PrimaryPart then
        local prim=seat.Parent==veh and seat or veh:FindFirstChildWhichIsA("BasePart",true)
        if prim then veh.PrimaryPart=prim end
    end
    return veh.PrimaryPart and seat,veh
end
local function CreateTracer()
    if TargetTracer then pcall(function()TargetTracer:Destroy()end)end
    local line=Instance.new("Part") line.Name="TargetTracer" line.Anchored=true line.CanCollide=false
    line.CastShadow=false line.Transparency=.35 line.BrickColor=BrickColor.new("Bright red")
    line.Material=Enum.Material.Neon line.Size=Vector3.new(.3,.3,0) line.Parent=Workspace
    TargetTracer=line
end
local function UpdateTracer(from,to)
    if not TargetTracer then CreateTracer()end
    if not TargetTracer then return end
    local dist=(from-to).Magnitude
    TargetTracer.Size=Vector3.new(.3,.3,dist)
    TargetTracer.CFrame=CFrame.new(from,to)*CFrame.new(0,0,-dist/2)
end
local function ClearTracer()if TargetTracer then pcall(function()TargetTracer:Destroy()end)end TargetTracer=nil end

