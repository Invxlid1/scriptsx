RunService.Heartbeat:Connect(function(dt)
    EnforceRules() local _,veh=GetSeatAndVehicle()
    if not veh or not veh.PrimaryPart then return end
    local prim=veh.PrimaryPart
    if freezeVelocity then prim.AssemblyLinearVelocity=Vector3.zero end
    if freezeCFrame and frozenCFrame then veh:PivotTo(frozenCFrame)end
    if freezeAngle or antiFlip or autoStabilize then
        local pos=prim.Position
        local look=Vector3.new(prim.CFrame.LookVector.X,0,prim.CFrame.LookVector.Z)
        look=look.Magnitude>.001 and look.Unit or Vector3.new(0,0,1)
        veh:PivotTo(CFrame.lookAt(pos,pos+look,Vector3.yAxis))
    end
    if autoWeightShift then
        local spd=prim.AssemblyLinearVelocity.Magnitude
        local props=PhysicalProperties.new(math.clamp(1.2-spd/400,.3,1),suspensionStrength,0,3,1)
        for _,d in ipairs(veh:GetDescendants())do if d:IsA("BasePart")then d.CustomPhysicalProperties=props end end
    end
end)

