--                     THEME REGISTRY
-- ══════════════════════════════════════════════════════════════════════
local ThemeRegistry, ThemeGradients = {}, {}
local function themed(inst, prop, key)
    ThemeRegistry[#ThemeRegistry+1] = {inst, prop, key}
    if T[key] ~= nil then pcall(function() inst[prop] = T[key] end) end
    return inst
end
local function themedGrad(g, key1, key2)
    ThemeGradients[#ThemeGradients+1] = {g, key1, key2}
    pcall(function() g.Color = ColorSequence.new(T[key1], T[key2]) end)
    return g
end
local function applyTheme()
    for _, e in ipairs(ThemeRegistry) do pcall(function() e[1][e[2]] = T[e[3]] end) end
    for _, e in ipairs(ThemeGradients) do pcall(function() e[1].Color = ColorSequence.new(T[e[2]], T[e[3]]) end) end
end

