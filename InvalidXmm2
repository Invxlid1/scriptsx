local espStore = {}
local function espColor(role)
    if not F.espRoleTags then return Color3.fromRGB(220, 220, 230) end
    if role == "Murderer" then return Color3.fromRGB(255, 90, 90) end
    if isGunRole(role) then return Color3.fromRGB(90, 150, 255) end
    return Color3.fromRGB(100, 220, 130)
end
local function tagOf(role)
    if role == "Murderer" then return "[M]"
    elseif isGunRole(role) then return "[S]" else return "[I]" end
end
local function clearEsp(p)
    local e = espStore[p]; if not e then return end
    if e.hl then e.hl:Destroy() end
    if e.bb then e.bb:Destroy() end
    espStore[p] = nil
end
local function ensureEsp(p)
    if espStore[p] then return espStore[p] end
    local e = {}
    e.hl = mk("Highlight", {
        FillTransparency = 1, OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false, Parent = EspGui})
    e.bb = mk("BillboardGui", {
        Size = UDim2.fromOffset(210, 22), AlwaysOnTop = true, Enabled = false,
        StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0), Parent = EspGui,
    }, {
        txt({Text = "", Font = FONT_BOLD, TextSize = 13,
            Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
            TextColor3 = Color3.new(1,1,1), TextStrokeTransparency = 0.3,
            TextStrokeColor3 = Color3.new(0,0,0)})})
    espStore[p] = e
    return e
end
bind(RunService.RenderStepped, function()
    if not (F.espNames or F.espChams) then
        for p in pairs(espStore) do clearEsp(p) end
        return
    end
    local camPos = Camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local e = ensureEsp(p)
            local role = roleOf(p)
            local col = espColor(role)
            local ch = p.Character
            local hrp = getHRP(ch)
            if F.espChams then
                e.hl.Enabled = true; e.hl.Adornee = ch
                e.hl.OutlineColor = col; e.hl.FillColor = col
                e.hl.FillTransparency = 1; e.hl.OutlineTransparency = 0
            else e.hl.Enabled = false end
            if F.espNames then
