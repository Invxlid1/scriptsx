local function mk(class, props, kids)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    for _, c in ipairs(kids or {}) do c.Parent = o end
    return o
end
local function corner(p, r) return mk("UICorner", {CornerRadius = UDim.new(0, r or 8), Parent = p}) end
local function stroke(p, c, t) return mk("UIStroke", {Color = c or T.border, Thickness = 1, Transparency = t or 0.4, Parent = p}) end
local function grad(p, c1, c2, rot)
    return mk("UIGradient", {Color = ColorSequence.new(c1, c2), Rotation = rot or 0, Parent = p})
end
local function txt(props)
    local base = props.TextSize or 13
    props.TextSize = math.floor(base * TM + 0.5)
    props.Font = props.Font or FONT
    props.BackgroundTransparency = 1
    props.TextColor3 = props.TextColor3 or T.text
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    return mk("TextLabel", props)
end
local function pressAnim(btn)
    local scale = Instance.new("UIScale"); scale.Parent = btn
    btn.MouseButton1Down:Connect(function() tw(scale, FAST, {Scale = 0.95}) end)
    btn.MouseButton1Up:Connect(function() tw(scale, SPRING, {Scale = 1}) end)
    btn.MouseLeave:Connect(function() tw(scale, FAST, {Scale = 1}) end)
    return scale
end
local function slideIn(frame, fromY, dur)
    fromY = fromY or 10
    local orig = frame.Position
    frame.Position = orig + UDim2.fromOffset(0, fromY)
    tw(frame, dur or EASE_OUT, {Position = orig})
end

