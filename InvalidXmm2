--                    FLING
-- ══════════════════════════════════════════════════════════════════════
local flinging = false
function flingPlayer(p)
    if flinging then return false, "Already flinging" end
    local myCh = LP.Character
    local myHrp = getHRP(myCh)
    local tHrp = p and p.Character and getHRP(p.Character)
    if not (myHrp and tHrp) then return false, "No character" end
    local back = myHrp.CFrame
    flinging = true
    local moved = false
    local t0 = os.clock()
    while os.clock() - t0 < 1 do
        RunService.Heartbeat:Wait()
        local h = getHRP(LP.Character)
        local t = p.Character and getHRP(p.Character)
        if not (h and t and h.Parent and t.Parent) then break end
        h.CFrame = t.CFrame
        moved = true
        local vel = h.AssemblyLinearVelocity
        h.AssemblyLinearVelocity = vel * 10000 + Vector3.new(0, 10000, 0)
        RunService.RenderStepped:Wait()
        if not h.Parent then break end
        h.AssemblyLinearVelocity = vel
    end
    local h2 = getHRP(LP.Character)
    if h2 then
        h2.CFrame = back
        h2.AssemblyLinearVelocity = Vector3.zero
        h2.AssemblyAngularVelocity = Vector3.zero
    end
    flinging = false
    return moved, moved and nil or "Could not grip"
end

