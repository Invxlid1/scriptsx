local function findDroppedGun()
    for _, d in ipairs(CollectionService:GetTagged("GunDrop")) do
        if d:IsA("BasePart") and d:IsDescendantOf(workspace) then return d end
    end
    for _, d in ipairs(workspace:GetChildren()) do
        if d:IsA("BasePart") and d.Name == "GunDrop" then return d end
    end
end
local grabbing = false
local function grabGun(h)
    if grabbing then return end
    if not inRound() then return end
    h = h or findDroppedGun()
    local hrp = getHRP(LP.Character)
    if not (h and h.Parent and hrp) then return end
    grabbing = true
    if typeof(firetouchinterest) == "function" then
        pcall(function() for _ = 1, 4 do
            firetouchinterest(hrp, h, 0); firetouchinterest(hrp, h, 1)
        end end)
    end
    if not findWeapon("Gun") then
        local back = hrp.CFrame
        for _ = 1, 8 do
            local my = getHRP(LP.Character)
            if not (my and h.Parent) then break end
            my.CFrame = CFrame.new(h.Position)
            my.AssemblyLinearVelocity = Vector3.zero
            if typeof(firetouchinterest) == "function" then
                pcall(function()
                    firetouchinterest(my, h, 0); firetouchinterest(my, h, 1)
                end)
            end
            if findWeapon("Gun") then break end
            RunService.Heartbeat:Wait()
        end
        local my = getHRP(LP.Character)
        if my then my.CFrame = back end
    end
    if findWeapon("Gun") then notify("invalidX", "Grabbed the gun", 2) end
    grabbing = false
end
task.spawn(function()
    while Gui.Parent do
        if F.autoGun and inRound() and not grabbing
           and roleOf(LP) ~= "Murderer" and not findWeapon("Gun") then
            local g = findDroppedGun(); if g then grabGun(g) end
        end
        task.wait(0.3)
    end
end)

