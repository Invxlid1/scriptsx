        TextColor3 = T.sub, Parent = btn})
    local isOn = isToggle and toggleFlag and F[toggleFlag] or false
    local function paint()
        if isToggle then
            if isOn then
                btn.BackgroundColor3 = T.accent
                lbl.TextColor3 = Color3.fromRGB(15, 15, 20)
            else
                btn.BackgroundColor3 = T.row
                lbl.TextColor3 = T.sub
            end
        end
    end
    paint()
    btn.MouseEnter:Connect(function()
        if not (isToggle and isOn) then
            tw(btn, FAST, {BackgroundColor3 = isDanger and Color3.fromRGB(60, 30, 35) or T.rowHi})
            tw(lbl, FAST, {TextColor3 = isDanger and T.danger or T.text})
        end
    end)
    btn.MouseLeave:Connect(function()
        if isToggle then paint()
        else
            tw(btn, FAST, {BackgroundColor3 = T.row})
            tw(lbl, FAST, {TextColor3 = T.sub})
        end
    end)
    pressAnim(btn)
    btn.MouseButton1Click:Connect(function()
        if isToggle then
            isOn = not isOn
            if toggleFlag then F[toggleFlag] = isOn end
            paint()
            if isOn then sparkleBurst(btn, btn.AbsoluteSize.X / 2, btn.AbsoluteSize.Y / 2, T.accent) end
            scheduleSave()
            if onClick then task.spawn(onClick, isOn) end
        else
            if onClick then task.spawn(onClick) end
        end
    end)
    table.insert(actionButtons, {btn = btn, flag = toggleFlag, paint = paint})
    return btn
end

-- Teleport
local function teleportTo(pos)
    local ch = LP.Character
    if not ch then return false end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if typeof(pos) ~= "Vector3" then return false end
    local dest = CFrame.new(pos + Vector3.new(0, 3, 0))
    pcall(function() hrp.CFrame = dest end)
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
    pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
    pcall(function() hrp.Velocity = Vector3.zero end)
    pcall(function() ch:PivotTo(dest) end)
    return true
end
local function teleportToPlayer(p)
    if not p or not p.Parent or not p.Character then return false end
    local hrp = getHRP(p.Character)
    if not hrp then return false end
    if teleportTo(hrp.Position) then
        notify("invalidX", "Teleported to " .. (p.DisplayName or p.Name), 2)
        return true
    end
    return false
end

