local coinFarm = {lastPos = nil, lastAt = 0, stuck = 0}
task.spawn(function()
    while Gui.Parent do
        if F.autoCoins and inRound() then
            local ch = LP.Character
            local hrp = ch and getHRP(ch)
            if hrp and ch then
                for _, p in ipairs(ch:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then
                        p.CanCollide = false; unclip[p] = true
                    end
                end
                local hum = ch:FindFirstChildOfClass("Humanoid")
                if hum and hum.PlatformStand then hum.PlatformStand = false end

                local best, bd
                for _, c in ipairs(coinCache) do
                    if c.Parent then
                        local d = (c.Position - hrp.Position).Magnitude
                        if d <= 300 and (not bd or d < bd) then bd, best = d, c end
                    end
                end
                if best then
                    local dir = best.Position - hrp.Position
                    local dist = dir.Magnitude
                    local dt = RunService.RenderStepped:Wait()
                    if dist > 2 then
                        local step = math.min(dist, 32 * dt)
                        hrp.CFrame = CFrame.new(hrp.Position + dir.Unit * step)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    else
                        if typeof(firetouchinterest) == "function" then
                            pcall(function()
                                firetouchinterest(hrp, best, 0)
                                firetouchinterest(hrp, best, 1)
                            end)
                        end
                        task.wait(0.08)
                    end
                    local now = os.clock()
                    if now - coinFarm.lastAt > 0.5 then
                        coinFarm.lastAt = now
                        if coinFarm.lastPos then
                            local moved = (hrp.Position - coinFarm.lastPos).Magnitude
                            if moved < 2.5 then
                                coinFarm.stuck = coinFarm.stuck + 1
                                hrp.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0))
                                hrp.AssemblyLinearVelocity = Vector3.zero
                            else coinFarm.stuck = 0 end
                        end
                        coinFarm.lastPos = hrp.Position
                    end
                else task.wait(0.25) end
            else task.wait(0.15) end
        else
            if next(unclip) then
                for p in pairs(unclip) do if p.Parent then p.CanCollide = true end end
                table.clear(unclip)
            end
            coinFarm.lastPos = nil; coinFarm.stuck = 0
            task.wait(0.25)
        end
    end
end)

function tpNearestCoin()
    if not inRound() then notify("invalidX", "Wait for a round to start", 2) return end
    local hrp = getHRP(LP.Character); if not hrp then return end
    local best, bd
    for _, c in ipairs(coinCache) do
        if c.Parent then
            local d = (c.Position - hrp.Position).Magnitude
            if not bd or d < bd then bd, best = d, c end
        end
    end
    if best then teleportTo(best.Position) end
end

