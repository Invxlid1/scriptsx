local orbitAt = 0
bind(RunService.RenderStepped, function()
    local p = Target.player
    if not (p and p.Parent) then return end
    local th = getHRP(p.Character); if not th then return end
    local my = getHRP(LP.Character); if not my then return end
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")

    if F.followTarget then
        my.CFrame = CFrame.new(th.Position + Vector3.new(0, 0.2, 0), th.Position)
        my.AssemblyLinearVelocity = Vector3.zero
    end
    if F.sitOnHead then
        local head = p.Character and p.Character:FindFirstChild("Head")
        if head then
            my.CFrame = head.CFrame + Vector3.new(0, 3.2, 0)
            my.AssemblyLinearVelocity = Vector3.zero
            my.AssemblyAngularVelocity = Vector3.zero
        end
    end
    if F.hugTarget then
        my.CFrame = th.CFrame * CFrame.new(0, 0, 2)
        my.AssemblyLinearVelocity = Vector3.zero
    end
    if F.orbitTarget then
        orbitAt = orbitAt + 0.05
        local pos = th.Position + Vector3.new(math.cos(orbitAt) * 8, 3, math.sin(orbitAt) * 8)
        my.CFrame = CFrame.new(pos, th.Position)
        my.AssemblyLinearVelocity = Vector3.zero
    end
    if F.yoyo then
        local t = tick() * 2.5
        local s = (math.sin(t) * 0.5) + 0.5
        local pos = my.CFrame.Position:Lerp(th.Position + Vector3.new(0, 4, 0), s * 0.2)
        my.CFrame = CFrame.new(pos)
        my.AssemblyLinearVelocity = Vector3.zero
    end
    if F.spamTP then
        my.CFrame = th.CFrame * CFrame.new(math.random(-4,4), math.random(0,5), math.random(-4,4))
        my.AssemblyLinearVelocity = Vector3.zero
    end
    if F.danceOnHead and hum then
        local head = p.Character and p.Character:FindFirstChild("Head")
        if head then
            local spin = tick() * 4
            local offset = Vector3.new(math.cos(spin) * 1.5, 3.2, math.sin(spin) * 1.5)
            my.CFrame = CFrame.new(head.Position + offset)
            my.AssemblyLinearVelocity = Vector3.zero
        end
    end
end)

