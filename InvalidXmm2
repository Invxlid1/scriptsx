local function addKeybindRow(flag, label, onPress, default)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, MOBILE and 40 or 34),
        BackgroundColor3 = T.row, BorderSizePixel = 0,
        LayoutOrder = #SettingsTab.holder:GetChildren() + 1, Parent = SettingsTab.holder})
