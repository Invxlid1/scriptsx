local KEY_PRETTY = {
    MouseButton1="LMB", MouseButton2="RMB", MouseButton3="MMB",
    LeftShift="LSHIFT", RightShift="RSHIFT", LeftControl="LCTRL", RightControl="RCTRL",
    LeftAlt="LALT", RightAlt="RALT", Space="SPACE", Return="ENTER", Tab="TAB",
    Backspace="BSPACE", Delete="DEL", Insert="INS", Home="HOME", End="END",
    PageUp="PGUP", PageDown="PGDN", CapsLock="CAPS",
    Up="UP", Down="DOWN", Left="LEFT", Right="RIGHT",
    MouseWheelUp="WHEEL+", MouseWheelDown="WHEEL-",
}
local function keyLabel(name)
    if not name or name == "" then return "—" end
    return KEY_PRETTY[name] or name:upper()
end

local Keybinds = {}
local listeningFor = nil

local function registerKeybind(flag, onPress)
    local entry = {flag = flag, key = F[flag], onPress = onPress}
    Keybinds[#Keybinds+1] = entry
    return entry
end

bind(UserInputService.InputBegan, function(input, processed)
    if listeningFor then
        local name = nil
        local t = input.UserInputType
        if t == Enum.UserInputType.Keyboard then name = input.KeyCode.Name
        elseif t == Enum.UserInputType.MouseButton1 then name = "MouseButton1"
        elseif t == Enum.UserInputType.MouseButton2 then name = "MouseButton2"
        elseif t == Enum.UserInputType.MouseButton3 then name = "MouseButton3"
        elseif t == Enum.UserInputType.MouseWheel then
            name = input.Position.Z > 0 and "MouseWheelUp" or "MouseWheelDown"
        end
        if name then
            if name == "Escape" then
                listeningFor = nil
            else
                listeningFor.key = name
                F[listeningFor.flag] = name
                if listeningFor.paint then listeningFor.paint() end
                scheduleSave()
                listeningFor = nil
            end
            return
        end
    end
    if processed then return end
    local name = nil
    local t = input.UserInputType
    if t == Enum.UserInputType.Keyboard then name = input.KeyCode.Name
    elseif t == Enum.UserInputType.MouseButton1 then name = "MouseButton1"
    elseif t == Enum.UserInputType.MouseButton2 then name = "MouseButton2"
    elseif t == Enum.UserInputType.MouseButton3 then name = "MouseButton3"
    end
    if not name then return end
    for _, kb in ipairs(Keybinds) do
        if kb.key == name and kb.onPress then pcall(kb.onPress) end
    end
end)

local function makeKeybindPill(parent, position, flag, onPress)
    local pill = mk("TextButton", {
        Size = UDim2.fromOffset(MOBILE and 54 or 48, 20),
        Position = position,
        BackgroundColor3 = T.input, BorderSizePixel = 0,
        AutoButtonColor = false, Text = "",
        ZIndex = 8, Parent = parent})
    corner(pill, 5)
    themed(pill, "BackgroundColor3", "input")
    local ps = stroke(pill, T.border, 0.5)
    themed(ps, "Color", "border")
    local lbl = txt({Text = "—", Font = FONT_MED, TextSize = 9,
        Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = T.dim, Parent = pill})

    local kb = registerKeybind(flag, onPress)
    function kb.paint()
        if listeningFor == kb then
            lbl.Text = "…"
            lbl.TextColor3 = T.accent
        else
            lbl.Text = keyLabel(kb.key)
            lbl.TextColor3 = kb.key and T.text or T.dim
        end
        ps.Transparency = kb.key and 0.2 or 0.5
    end
    kb.paint()

    pill.MouseButton1Click:Connect(function()
        listeningFor = (listeningFor == kb) and nil or kb
        kb.paint()
    end)
    pill.MouseButton2Click:Connect(function()
        kb.key = nil
        F[flag] = nil
        kb.paint()
        scheduleSave()
    end)
    return kb
end

