local function attachKb(holder, labelText, flag, onPress)
    for _, child in ipairs(holder:GetChildren()) do
        if child:IsA("TextButton") then
            for _, c in ipairs(child:GetChildren()) do
                if c:IsA("TextLabel") and c.Text == labelText then
                    makeKeybindPill(child, UDim2.new(1, -(TRACK_W + 60), 0.5, -10), flag, onPress)
