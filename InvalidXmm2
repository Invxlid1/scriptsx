local function refreshSugs()
    clearSugs()
    local q = inputBox.Text
    local list = {}
    if q == "" then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then table.insert(list, p) end end
    else
        local ql = q:lower()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local nm = p.Name:lower()
                local dn = (p.DisplayName or ""):lower()
                if nm:sub(1, #ql) == ql or dn:sub(1, #ql) == ql
                    or nm:find(ql, 1, true) or dn:find(ql, 1, true) then
                    table.insert(list, p)
                end
            end
        end
    end
    local count = 0
    for _, p in ipairs(list) do
        if count >= 6 then break end
        count = count + 1
        local r = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
            LayoutOrder = count, Parent = sugList})
        corner(r, 6)
        txt({Text = p.DisplayName or p.Name, Font = FONT_MED, TextSize = 12,
            Position = UDim2.fromOffset(12, 2), Size = UDim2.new(1, -14, 0, 15),
            TextColor3 = T.text, Parent = r})
        txt({Text = "@" .. p.Name, Font = FONT, TextSize = 10,
            Position = UDim2.fromOffset(12, 17), Size = UDim2.new(1, -14, 0, 12),
            TextColor3 = T.dim, Parent = r})
        r.MouseEnter:Connect(function() tw(r, FAST, {BackgroundColor3 = T.rowHi, BackgroundTransparency = 0}) end)
        r.MouseLeave:Connect(function() tw(r, FAST, {BackgroundTransparency = 1}) end)
        r.MouseButton1Click:Connect(function() applyTarget(p, false) end)
        table.insert(sugButtons, r)
    end
    if #sugButtons > 0 then
        sugHolder.Visible = true
        tw(sugHolder, EASE_OUT, {Size = UDim2.new(1, 0, 0, math.min(210, #sugButtons * 34 + 10))})
    end
end
