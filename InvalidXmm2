local KNIFE_PARTS = {"HumanoidRootPart","UpperTorso","LowerTorso","Torso","Head"}
local function knifeKill(ev, targetChar)
    if not (ev and targetChar) then return end
    local ht = ev:FindFirstChild("HandleTouched")
    if not ht then return end
    local ks = ev:FindFirstChild("KnifeStabbed")
    if ks then pcall(function() ks:FireServer() end) end
    for _, pn in ipairs(KNIFE_PARTS) do
        local part = targetChar:FindFirstChild(pn)
        if part then ht:FireServer(part); return end
    end
end

local GUN_CD = 3.25
local snapAt = -10
local snapping = false
local function snapShot(target)
    if snapping then return end
    if os.clock() - snapAt < GUN_CD then return end
    local gun = findWeapon("Gun"); if not gun then return end
    local shoot = gun:FindFirstChild("Shoot"); if not shoot then return end
    local tHrp = target.Character and getHRP(target.Character)
    local myHrp = getHRP(LP.Character)
    if not (tHrp and myHrp) then return end
    snapping = true
    pcall(function()
        equip(gun); task.wait(0.1)
        local home = myHrp.CFrame
        local chest = tHrp.Position
        for _ = 1, 15 do
            local h = getHRP(LP.Character)
            local t = target.Character and getHRP(target.Character)
            if not (h and t) then break end
            chest = t.Position
            h.CFrame = CFrame.new(chest + Vector3.new(0, 0.2, 0), chest)
            h.AssemblyLinearVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
        end
        shoot:FireServer()
        snapAt = os.clock()
        task.wait(0.1)
        local h = getHRP(LP.Character)
        if h then h.CFrame = home; h.AssemblyLinearVelocity = Vector3.zero end
    end)
    snapping = false
end

