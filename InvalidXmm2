--                    SERVER HOP / REJOIN
-- ══════════════════════════════════════════════════════════════════════
function rejoin()
    notify("invalidX", "Rejoining...", 2)
    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
end
function serverHop()
    notify("invalidX", "Finding a server...", 2)
    task.spawn(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if not ok then notify("invalidX", "Server list failed", 3) return end
        local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
        if not (ok2 and data and data.data) then notify("invalidX", "No servers", 3) return end
        local cands = {}
        for _, sv in ipairs(data.data) do
            if sv.id and sv.id ~= game.JobId and (sv.playing or 0) < (sv.maxPlayers or 0) then
                cands[#cands+1] = sv
            end
        end
        table.sort(cands, function(a, b) return (a.playing or 0) > (b.playing or 0) end)
        if #cands == 0 then notify("invalidX", "No joinable servers", 3) return end
        local pick = cands[math.random(1, math.min(#cands, 5))]
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LP) end)
    end)
end

