    kb_espNames=nil, kb_espBox=nil, kb_espChams=nil,
    kb_instant=nil, kb_tpTarget=nil, kb_killTarget=nil,
}
local function saveSettings()
    if not canSave then return end
    ensureFolder()
    local d = {}
    for k, v in pairs(F) do
        if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then d[k] = v end
    end
    -- Save keybinds separately
    for _, kb in ipairs(Keybinds or {}) do
        if kb.flag then d[kb.flag] = kb.key end
    end
    pcall(function() writefile(SAVE_FILE, HttpService:JSONEncode(d)) end)
end
local function loadSettings()
    if not canSave then return end
    if typeof(isfile) == "function" and not isfile(SAVE_FILE) then return end
    local ok, raw = pcall(readfile, SAVE_FILE)
    if not ok then return end
    local ok2, d = pcall(function() return HttpService:JSONDecode(raw) end)
    if not (ok2 and type(d) == "table") then return end
    for k, v in pairs(d) do
        if F[k] ~= nil and type(F[k]) == type(v) then F[k] = v end
    end
    if THEMES[F.theme] then for k, v in pairs(THEMES[F.theme]) do T[k] = v end end
end
loadSettings()

local savePending = false
local function scheduleSave()
    if not canSave or savePending then return end
    savePending = true
    task.delay(0.6, function() savePending = false; saveSettings() end)
end

