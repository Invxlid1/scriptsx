local function sparkleBurst(parent, x, y, color)
    for i = 1, 6 do
        local a = (i / 6) * math.pi * 2 + math.random() * 0.5
        local dist = 14 + math.random(0, 8)
        local p = mk("Frame", {
            Size = UDim2.fromOffset(4, 4), Position = UDim2.fromOffset(x, y),
            BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 50, Parent = parent})
        corner(p, 2)
        local target = UDim2.fromOffset(x + math.cos(a) * dist, y + math.sin(a) * dist)
        tw(p, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Position = target, BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 2)})
        task.delay(0.45, function() pcall(function() p:Destroy() end) end)
    end
end

