--                    INSTANT KNIFE THROW
-- ══════════════════════════════════════════════════════════════════════
local lastInstantAt = -10
local function instantThrow()
    if not F.instantKnife then return end
    if not inRound() then return end
    if roleOf(LP) ~= "Murderer" then return end
    local ch = LP.Character; if not ch then return end
    local knife = ch:FindFirstChild("Knife")
    if not knife then
        local bp = LP:FindFirstChildOfClass("Backpack")
        local stowed = bp and bp:FindFirstChild("Knife")
        if stowed then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:EquipTool(stowed) end) end
            knife = ch:FindFirstChild("Knife") or stowed
        end
    end
    if not knife then return end
    local ev = knife:FindFirstChild("Events")
    local thrown = ev and ev:FindFirstChild("KnifeThrown")
    if not thrown then return end
    if knife:GetAttribute("Disabled") == true then return end
    if os.clock() - lastInstantAt < 2 then return end

    local target
    if silentTarget then target = silentTarget
    else
        local p = fovTarget()
        if p then
            local head = p.Character and (p.Character:FindFirstChild("Head") or getHRP(p.Character))
            if head then target = head.Position end
        end
    end
    if not target then return end
    local hrp = getHRP(ch); if not hrp then return end
    local d = target - hrp.Position
    d = (d.Magnitude > 0.1) and d.Unit or Vector3.new(0, 0, -1)
    lastInstantAt = os.clock()
    local handle = knife:FindFirstChild("Handle")
    local origin = handle and handle.CFrame or CFrame.new(target - d * 0.6, target)
    pcall(function() thrown:FireServer(origin, CFrame.new(target)) end)
end

bind(UserInputService.InputBegan, function(input, processed)
