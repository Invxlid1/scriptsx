local function fovTarget()
    local center = UserInputService:GetMouseLocation()
    local best, bestD
    local myRole = roleOf(LP)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local r = roleOf(p)
            local valid = (myRole == "Murderer") or (isGunRole(myRole) and r == "Murderer")
            if valid then
                local hrp = getHRP(p.Character)
                if hrp then
                    local v, on = Camera:WorldToViewportPoint(hrp.Position)
                    if on and v.Z > 0 then
                        local d = (Vector2.new(v.X, v.Y) - center).Magnitude
                        if d <= F.aimFov and (not bestD or d < bestD) then bestD, best = d, p end
                    end
                end
            end
        end
    end
    return best
end
