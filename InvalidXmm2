        TextColor3 = T.text, Parent = row})
    themed(l, "TextColor3", "text")
    local track = mk("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(TRACK_W, TRACK_H),
        BackgroundColor3 = F[flag] and T.accent or T.rowHi,
        BorderSizePixel = 0, Parent = row})
    corner(track, math.floor(TRACK_H / 2))
    local knob = mk("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, F[flag] and (TRACK_W - TRACK_H + 3) or 3, 0.5, 0),
        Size = UDim2.fromOffset(TRACK_H - 6, TRACK_H - 6),
        BackgroundColor3 = T.text, BorderSizePixel = 0, Parent = track})
    corner(knob, math.floor((TRACK_H - 6) / 2))
    local function paint(anim)
        local ti = anim and FAST or TweenInfo.new(0)
        tw(track, ti, {BackgroundColor3 = F[flag] and T.accent or T.rowHi})
        tw(knob, anim and EASE_OUT or TweenInfo.new(0),
            {Position = UDim2.new(0, F[flag] and (TRACK_W - TRACK_H + 3) or 3, 0.5, 0)})
    end
    local function set(v, fire)
        local was = F[flag]
        F[flag] = v and true or false
        paint(true)
        if F[flag] and not was then sparkleBurst(row, TRACK_W - 6, math.floor(ROW_H / 2 - 2), T.accent) end
        scheduleSave()
        if fire and callback then task.spawn(callback, F[flag]) end
    end
    row.MouseButton1Click:Connect(function() set(not F[flag], true) end)
    row.MouseEnter:Connect(function() tw(row, FAST, {BackgroundColor3 = T.rowHi}) end)
    row.MouseLeave:Connect(function() tw(row, FAST, {BackgroundColor3 = T.row}) end)
    pressAnim(row)
    return {row = row, set = set, paint = paint}
end

local function addSlider(tab, label, flag, min, max, step, fmt, callback)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, ROW_H + 20),
        BackgroundColor3 = T.row, BorderSizePixel = 0, Parent = tab.holder})
    corner(row, 10)
    themed(row, "BackgroundColor3", "row")
    local valLbl = txt({Text = fmt and fmt(F[flag]) or tostring(F[flag]),
        Font = FONT_MED, TextSize = 12,
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 10),
        Size = UDim2.fromOffset(70, 14), TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = T.accent, Parent = row})
    themed(valLbl, "TextColor3", "accent")
    txt({Text = label, Font = FONT, TextSize = 13,
        Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -90, 0, 16),
        TextColor3 = T.text, Parent = row})
    local bar = mk("Frame", {
        Position = UDim2.new(0, 14, 0, ROW_H - 4),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = T.border, BorderSizePixel = 0, Parent = row})
    corner(bar, 3)
    themed(bar, "BackgroundColor3", "border")
    local fill = mk("Frame", {
        Size = UDim2.new((F[flag] - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.accent, BorderSizePixel = 0, Parent = bar})
    corner(fill, 3)
    themedGrad(grad(fill, T.accent, T.accent2), "accent", "accent2")
    local knob = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((F[flag] - min) / (max - min), 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = T.text, BorderSizePixel = 0, Parent = bar})
    corner(knob, 7)
    local dragging = false
    local function applyFromX(px)
        local rel = math.clamp((px - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local v = min + (max - min) * rel
        if step then v = math.floor(v / step + 0.5) * step end
        v = math.floor(v + 0.5)
        F[flag] = v
        local r = (v - min) / (max - min)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        valLbl.Text = fmt and fmt(v) or tostring(v)
        scheduleSave()
        if callback then callback(v) end
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; applyFromX(i.Position.X)
        end
    end)
    bind(UserInputService.InputChanged, function(i)
        if not dragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            applyFromX(i.Position.X)
        end
    end)
    bind(UserInputService.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

