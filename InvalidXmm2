local function getHRP(ch) return ch and ch:FindFirstChild("HumanoidRootPart") end
local function alive(plr)
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return false end
    return getHRP(ch) ~= nil
end
local CRC
pcall(function() CRC = require(RS:WaitForChild("Modules"):WaitForChild("CurrentRoundClient")) end)
local function roundData(plr) return CRC and CRC.PlayerData and CRC.PlayerData[plr.Name] end

-- Round state
local roundAt = -10
local ROUND_GRACE = 2.5
local function markRound() roundAt = os.clock() end
local function inGrace() return os.clock() - roundAt < ROUND_GRACE end
local function inRound()
    if inGrace() then return false end
    local maps = CollectionService:GetTagged("CurrentMap")
    if not maps or #maps == 0 then return false end
    local ch = LP.Character
    if not ch or not ch.Parent then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return false end
    if not getHRP(ch) then return false end
    local d = roundData(LP)
    if d and d.Dead == true then return false end
    return true
end

local function roleOf(plr)
    local d = roundData(plr)
    if d and d.Role == "Murderer" then return "Murderer" end
    if d and (d.Role == "Sheriff" or d.Role == "Hero") then return "Sheriff" end
    local ch = plr.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then
                if t.Name == "Gun" then return "Sheriff" end
                if t.Name == "Knife" then return "Murderer" end
            end
        end
    end
    return (d and d.Role) or "Innocent"
end
local function isGunRole(r) return r == "Sheriff" or r == "Hero" end
local function findMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if roleOf(p) == "Murderer" then return p end
    end
end
local function findWeapon(name)
    local ch = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    return (ch and ch:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
end
local function equip(tool)
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if tool and hum and tool.Parent ~= ch then pcall(function() hum:EquipTool(tool) end) end
end

