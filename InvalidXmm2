    txt({Text = label, Font = FONT, TextSize = 12,
        Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -80, 1, 0),
        TextColor3 = T.text, Parent = row})
    local kb = makeKeybindPill(row, UDim2.new(1, -(MOBILE and 66 or 60), 0.5, -10), flag, onPress)
    if default and not kb.key then
        kb.key = default
        F[flag] = default
        kb.paint()
    end
    return kb
end

