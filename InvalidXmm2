    local lv = hrp.AssemblyLinearVelocity
    if lv.Magnitude > 200 then hrp.AssemblyLinearVelocity = lv.Unit * 200 end
    local av = hrp.AssemblyAngularVelocity
    if av.Magnitude > 20 then hrp.AssemblyAngularVelocity = Vector3.zero end
end)
local murdererWarned = false
bind(RunService.Heartbeat, function()
    if not F.murdererNotify then murdererWarned = false return end
    local hrp = getHRP(LP.Character)
    local m = findMurderer()
    local mh = m and m ~= LP and alive(m) and getHRP(m.Character)
    if not (hrp and mh) then return end
    local d = math.floor((mh.Position - hrp.Position).Magnitude)
    if d <= 50 and not murdererWarned then
        murdererWarned = true
        notify("Murderer Nearby", (m.DisplayName or m.Name) .. " · " .. d .. "m", 3)
    elseif d > 50 then murdererWarned = false end
end)

