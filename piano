-- ═══════════════════════════════════════════════════════════════
--  KEYCODE MAPS
-- ═══════════════════════════════════════════════════════════════
local LETTER_MAP = {
    a = Enum.KeyCode.A, b = Enum.KeyCode.B, c = Enum.KeyCode.C, d = Enum.KeyCode.D,
    e = Enum.KeyCode.E, f = Enum.KeyCode.F, g = Enum.KeyCode.G, h = Enum.KeyCode.H,
    i = Enum.KeyCode.I, j = Enum.KeyCode.J, k = Enum.KeyCode.K, l = Enum.KeyCode.L,
    m = Enum.KeyCode.M, n = Enum.KeyCode.N, o = Enum.KeyCode.O, p = Enum.KeyCode.P,
    q = Enum.KeyCode.Q, r = Enum.KeyCode.R, s = Enum.KeyCode.S, t = Enum.KeyCode.T,
    u = Enum.KeyCode.U, v = Enum.KeyCode.V, w = Enum.KeyCode.W, x = Enum.KeyCode.X,
    y = Enum.KeyCode.Y, z = Enum.KeyCode.Z,
    ["0"] = Enum.KeyCode.Zero, ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two,
    ["3"] = Enum.KeyCode.Three, ["4"] = Enum.KeyCode.Four, ["5"] = Enum.KeyCode.Five,
    ["6"] = Enum.KeyCode.Six, ["7"] = Enum.KeyCode.Seven, ["8"] = Enum.KeyCode.Eight,
    ["9"] = Enum.KeyCode.Nine,
}
local SHIFT_MAP = {
    ["!"] = Enum.KeyCode.One, ["@"] = Enum.KeyCode.Two, ["#"] = Enum.KeyCode.Three,
    ["$"] = Enum.KeyCode.Four, ["%"] = Enum.KeyCode.Five, ["^"] = Enum.KeyCode.Six,
    ["&"] = Enum.KeyCode.Seven, ["*"] = Enum.KeyCode.Eight, ["("] = Enum.KeyCode.Nine,
    [")"] = Enum.KeyCode.Zero,
}
local TRANSPOSE_ROWS = {
    { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" },
    { "q", "w", "e", "r", "t", "y", "u", "i", "o", "p" },
    { "a", "s", "d", "f", "g", "h", "j", "k", "l", ";" },
    { "z", "x", "c", "v", "b", "n", "m", ",", ".", "/" },
}

local function charToKeys(ch)
    if ch == "" then return {} end
    local lower = ch:lower()
    if LETTER_MAP[lower] then return { LETTER_MAP[lower] } end
    if SHIFT_MAP[ch] then return { Enum.KeyCode.LeftShift, SHIFT_MAP[ch] } end
    return {}
end

local function transposeChar(ch, steps)
    if steps == 0 then return ch end
    local isShift = ch:match("[!@#%$%%%^&*%(%)]") ~= nil
    local base = ch:lower()
    for rowIdx, row in ipairs(TRANSPOSE_ROWS) do
        for colIdx, key in ipairs(row) do
            if key == base then
                local newCol = math.clamp(colIdx + steps, 1, 10)
                local newKey = TRANSPOSE_ROWS[rowIdx][newCol]
                if isShift and newKey:match("[1-90]") then
                    local symMap = {["1"]="!",["2"]="@",["3"]="#",["4"]="$",["5"]="%",["6"]="^",["7"]="&",["8"]="*",["9"]="(",["0"]=")"}
                    return symMap[newKey] or newKey
                end
                return newKey
            end
        end
    end
    return ch
end

local function applyTranspose(sheet, steps)
    if steps == 0 then return sheet end
    return (sheet:gsub("[%a%d!@#%$%%%^&*%(%)]", function(c) return transposeChar(c, steps) end))
end

-- ═══════════════════════════════════════════════════════════════
--  PARSER
-- ═══════════════════════════════════════════════════════════════
local function parseSheet(sheet)
    local events = {}
    local i, len = 1, #sheet
    while i <= len do
        local c = sheet:sub(i, i)
        if c == "#" then
            local nl = sheet:find("\n", i)
            i = nl and nl + 1 or len + 1
        elseif c == "[" then
            local close = sheet:find("]", i)
            if not close then break end
            local inside = sheet:sub(i + 1, close - 1)
            local keys = {}
            for k = 1, #inside do
                local ch = inside:sub(k, k)
                if ch ~= " " and ch ~= "\n" and ch ~= "\r" then
                    for _, kc in ipairs(charToKeys(ch)) do table.insert(keys, kc) end
                end
            end
            if #keys > 0 then table.insert(events, { keys = keys, wait = 0.02 }) end
            i = close + 1
        elseif c == "-" then
            local dashes = 1
            if sheet:sub(i + 1, i + 1) == "-" then dashes = 2 end
            table.insert(events, { keys = {}, wait = dashes == 2 and 0.35 or 0.15 })
            i = i + dashes
        elseif c:match("[%a%d]") then
            table.insert(events, { keys = charToKeys(c), wait = 0.02 })
            i = i + 1
        elseif SHIFT_MAP[c] then
            table.insert(events, { keys = charToKeys(c), wait = 0.02 })
            i = i + 1
        elseif c == "|" or c == "\n" or c == "\r" then
            table.insert(events, { keys = {}, wait = 0.08 })
            i = i + 1
        elseif c == " " then
            table.insert(events, { keys = {}, wait = 0.03 })
            i = i + 1
        else
            i = i + 1
        end
    end
    return events
end

local function estimateDuration(events, speed)
    local total = 0
    for _, ev in ipairs(events) do
        total = total + (ev.wait or 0.02) + 0.02
    end
    return total / (speed or 1)
end

local function formatTime(sec)
    sec = math.max(0, math.floor(sec))
    return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

