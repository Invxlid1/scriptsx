--  PLAYBACK FUNCTIONS
-- ═══════════════════════════════════════════════════════════════
local function updateSheetInfo()
    if not content then return end
    if #sheetText < 3 then
        statusLbl.Text = "Paste a sheet in the SHEET tab"
        return
    end
    local events = parseSheet(sheetText)
    local notes, chords = 0, 0
    for _, ev in ipairs(events) do
        if #ev.keys > 0 then
            if #ev.keys > 2 then chords = chords + 1 else notes = notes + 1 end
        end
    end
    local dur = estimateDuration(events, tonumber(CURRENT.Speed) or 1)
    statusLbl.Text = string.format("%d notes • %d chords • ~%s", notes, chords, formatTime(dur))
end

local function updateProgress()
    local total = #currentEvents
    if total == 0 then return end
    progressFill.Size = UDim2.new(currentIndex / total, 0, 1, 0)
    local elapsed = tick() - playStartTime
    local remain = math.max(0, estimatedDuration - elapsed)
    timeLbl.Text = formatTime(elapsed) .. " / " .. formatTime(estimatedDuration)
end

local function startPlay()
    if isPlaying then stopFlag = true; task.wait(0.15) end
    if #sheetText < 3 then
        statusLbl.Text = "⚠ Sheet is empty"
        return
    end
    local sheet = applyTranspose(sheetText, tonumber(CURRENT.Transpose) or 0)
    currentEvents = parseSheet(sheet)
    if #currentEvents == 0 then
        statusLbl.Text = "⚠ No notes found"
        return
    end
    estimatedDuration = estimateDuration(currentEvents, tonumber(CURRENT.Speed) or 1)
    isPlaying, stopFlag = true, false
    currentIndex = 0

    if CURRENT.AutoHide and not IS_MOBILE then
        content.Visible = false
        autoHid = true
    end

    playThread = task.spawn(function()
        for i = tonumber(CURRENT.Countdown) or 3, 1, -1 do
            if stopFlag then break end
            statusLbl.Text = "Starting in " .. i .. "..."
            task.wait(1)
        end
        playStartTime = tick()
        local speed = tonumber(CURRENT.Speed) or 1
        local hold = tonumber(CURRENT.KeyHold) or 0.04
        local arp = tonumber(CURRENT.ChordArpeggio) or 0
        local human = tonumber(CURRENT.Humanize) or 0

        while true do
            if stopFlag then break end
            for idx, ev in ipairs(currentEvents) do
                if stopFlag then break end
                currentIndex = idx
                if #ev.keys > 0 then
                    if arp > 0 and #ev.keys > 1 then
                        for _, kc in ipairs(ev.keys) do
                            pcall(function() VirtualInputManager:SendKeyEvent(true, kc, false, game) end)
                            task.wait(arp / speed)
                        end
                    else
                        pressKeys(ev.keys)
                    end
                    task.wait(math.max(0.005, hold / speed))
                    releaseKeys(ev.keys)
                end
                local baseWait = (ev.wait or 0.02)
                if human > 0 then baseWait = baseWait + (math.random() * human / 100) end
                task.wait(math.max(0.005, baseWait / speed))
                if idx % 5 == 0 then updateProgress() end
            end
            if not CURRENT.Loop then break end
        end
        isPlaying = false
        stopFlag = false
        currentIndex = 0
        progressFill.Size = UDim2.new(0, 0, 1, 0)
        timeLbl.Text = "0:00 / 0:00"
        statusLbl.Text = "✅ Finished"
        if autoHid then content.Visible = true; autoHid = false end
    end)
end

local function stopPlay()
    stopFlag = true
    isPlaying = false
    statusLbl.Text = "⏹ Stopped"
    if autoHid then content.Visible = true; autoHid = false end
end

playBtn.MouseButton1Click:Connect(startPlay)
stopBtn.MouseButton1Click:Connect(stopPlay)

