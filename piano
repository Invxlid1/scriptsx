    Speed = 1.0, KeyHold = 0.04, ChordArpeggio = 0.0, Humanize = 0,
    Transpose = 0, Countdown = 3, Loop = false, AntiAFK = true,
    AutoHide = false, Theme = "Purple", UIScale = 1.0,
    LastSheet = "",
}
local CURRENT = {}

local function loadConfig()
    local loaded = nil
    if HAS_FILE_IO and isfile(CONFIG_FILE) then
        local ok, data = pcall(readfile, CONFIG_FILE)
        if ok and #data > 0 then
            local ok2, dec = pcall(function() return HttpService:JSONDecode(data) end)
            if ok2 and typeof(dec) == "table" then loaded = dec end
        end
    end
    for k, v in pairs(DEFAULTS) do
        CURRENT[k] = (loaded and loaded[k] ~= nil) and loaded[k] or v
    end
end

local function saveConfig()
    if not HAS_FILE_IO then return end
    local ok, data = pcall(function() return HttpService:JSONEncode(CURRENT) end)
    if ok then pcall(writefile, CONFIG_FILE, data) end
end

loadConfig()

if HAS_FILE_IO then
    pcall(function()
        if typeof(makefolder) == "function" then pcall(makefolder, SHEET_FOLDER) end
        pcall(function() writefile(SHEET_FOLDER .. "/.keep", "") end)
    end)
