    local modeIdx = modeMap[CURRENT.ESP_Mode] or 1
    MakeDropdown("ESP Mode", {"Skeleton", "Tracers", "Both", "NameOnly", "Boxes", "HeadDot"}, modeIdx, function(m)
        CURRENT.ESP_Mode = m
    end, 50)

    MakeToggle("Show Player Name", CURRENT.ESP_ShowName, function(s)
        CURRENT.ESP_ShowName = s
        IX.ESP_ShowName = s
    end, 100)
    MakeToggle("Show Distance", CURRENT.ESP_ShowDistance, function(s)
        CURRENT.ESP_ShowDistance = s
        IX.ESP_ShowDistance = s
    end, 148)

    local colorModeIdx = CURRENT.ESP_ColorMode == "Solid" and 2 or 1
    MakeDropdown("Color Mode", {"Rainbow", "Solid"}, colorModeIdx, function(m)
        CURRENT.ESP_ColorMode = m
    end, 198)

    MakeSlider("Rainbow Speed", CURRENT.RainbowSpeed, 0.3, 3.0, 1, function(v)
        CURRENT.RainbowSpeed = v
    end, 250)

    local colors = {
        {n = "Cyan",  v = {r = 0,   g = 170, b = 255}},
        {n = "Red",   v = {r = 255, g = 60,  b = 80}},
        {n = "Purple",v = {r = 180, g = 80,  b = 255}},
        {n = "Lime",  v = {r = 80,  g = 255, b = 140}},
        {n = "Gold",  v = {r = 255, g = 200, b = 60}},
        {n = "White", v = {r = 255, g = 255, b = 255}},
        {n = "Pink",  v = {r = 255, g = 100, b = 200}},
        {n = "Orange",v = {r = 255, g = 140, b = 40}},
    }
    local names, idx = {}, 1
    for i, c in ipairs(colors) do
        names[i] = c.n
        if CURRENT.ESP_SolidColor.r == c.v.r and CURRENT.ESP_SolidColor.g == c.v.g and CURRENT.ESP_SolidColor.b == c.v.b then
            idx = i
        end
    end
    MakeDropdown("Solid Preset", names, idx, function(n)
        for _, c in ipairs(colors) do
            if c.n == n then
                CURRENT.ESP_SolidColor = c.v
                SaveSettings()
                break
            end
        end
    end, 310)

    MakeSlider("Line Thickness", CURRENT.LineThickness, 1.0, 3.0, 1, function(v)
        CURRENT.LineThickness = v
    end, 368)
end

