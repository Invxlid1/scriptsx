-- ═══════════════════════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if waitingBind and input.KeyCode ~= Enum.KeyCode.Unknown then
        local kc = input.KeyCode
        waitingBind.Button.Text = "   "..waitingBind.Label.."    "..kc.Name
        waitingBind.Button.BackgroundColor3 = ActiveTheme.Element
        waitingBind.Set(kc)
        waitingBind = nil
        SaveSettings()
        ShowNotification("⌨️ Bound", kc.Name .. " assigned", 1.5)
        return
    end

    if input.KeyCode == KB_TRIG then
        Trigger_Enabled = not Trigger_Enabled
        CURRENT.Trigger_Enabled = Trigger_Enabled
        IX.Trigger_Enabled = Trigger_Enabled
        UpdateStatusBar()
        ShowNotification(Trigger_Enabled and "🎯 Trigger ON" or "🎯 Trigger OFF", KB_TRIG.Name, 1.5)
        SaveSettings()
    elseif input.KeyCode == KB_AIM then
        AIM_Enabled = not AIM_Enabled
        CURRENT.AIM_Enabled = AIM_Enabled
        IX.AIM_Enabled = AIM_Enabled
        UpdateStatusBar()
        ShowNotification(AIM_Enabled and "🧠 Aim ON" or "🧠 Aim OFF", KB_AIM.Name, 1.5)
        SaveSettings()
    elseif input.KeyCode == KB_ESP then
        ESP_Enabled = not ESP_Enabled
        CURRENT.ESP_Enabled = ESP_Enabled
        IX.ESP_Enabled = ESP_Enabled
        UpdateStatusBar()
        ShowNotification(ESP_Enabled and "🌈 ESP ON" or "🌈 ESP OFF", KB_ESP.Name, 1.5)
        SaveSettings()
    elseif input.KeyCode == KB_TP then
        CURRENT.ThirdPerson_Enabled = not CURRENT.ThirdPerson_Enabled
        UpdateStatusBar()
        ShowNotification(CURRENT.ThirdPerson_Enabled and "📷 TP ON" or "📷 TP OFF", KB_TP.Name, 1.5)
        SaveSettings()
    elseif input.KeyCode == KB_SH then
        CURRENT.SpeedHack_Enabled = not CURRENT.SpeedHack_Enabled
        UpdateStatusBar()
        ShowNotification(CURRENT.SpeedHack_Enabled and "⚡ Speed ON" or "⚡ Speed OFF", KB_SH.Name, 1.5)
        SaveSettings()
    elseif input.KeyCode == KB_UI then
        ToggleUI()
    elseif input.KeyCode == KB_PANIC then
        AIM_Enabled = false
        Trigger_Enabled = false
        ESP_Enabled = false
        CURRENT.AIM_Enabled = false
        CURRENT.Trigger_Enabled = false
        CURRENT.ESP_Enabled = false
        CURRENT.ThirdPerson_Enabled = false
        CURRENT.SpeedHack_Enabled = false
        IX.AIM_Enabled = false
        IX.Trigger_Enabled = false
        IX.ESP_Enabled = false
        UpdateStatusBar()
        ShowNotification("🚨 PANIC", "All features off", 2)
        SaveSettings()
    end
end)

