local function CleanupPlayerData(data)
    if not data then return end
    for _, l in ipairs(data.Lines) do pcall(function() l:Remove() end) end
    if data.Tracer then pcall(function() data.Tracer:Remove() end) end
    if data.Info   then pcall(function() data.Info:Remove() end)   end
    if data.Box    then pcall(function() data.Box:Remove() end)    end
    for _, c in ipairs(data.Conns) do pcall(function() c:Disconnect() end) end
end

local function SetupPlayerESP(ply)
    if ply == LocalPlayer then return end
    if PlayerData[ply] then CleanupPlayerData(PlayerData[ply]) end
    task.spawn(CheckPlayerStats, ply)
    ThreatState[ply] = ThreatState[ply] or {lastRusherAlert = 0, lastAimLockAlert = 0, lastBackstabAlert = 0}
    local data = {Lines = {}, Tracer = nil, Info = nil, Box = nil, Char = nil, Joints = {}, Conns = {}}
    local function LoadChar(c)
        data.Char = c
        for _, l in ipairs(data.Lines) do pcall(function() l:Remove() end) end
        if data.Tracer then pcall(function() data.Tracer:Remove() end) end
        if data.Info   then pcall(function() data.Info:Remove() end)   end
        if data.Box    then pcall(function() data.Box:Remove() end)    end
        data.Lines = {}
        data.Joints = GetSkeletonJoints(c)
        for _ = 1, #data.Joints do table.insert(data.Lines, CreateLine()) end
        data.Tracer = CreateLine()
        data.Info = CreateText()
        data.Box = CreateBox()
    end
    if ply.Character then LoadChar(ply.Character) end
    table.insert(data.Conns, ply.CharacterAdded:Connect(function(c) task.wait(0.1); LoadChar(c) end))
    table.insert(data.Conns, ply.CharacterRemoving:Connect(function()
        data.Char = nil; data.Joints = {}
        for _, l in ipairs(data.Lines) do l.Visible = false end
        if data.Tracer then data.Tracer.Visible = false end
        if data.Info then data.Info.Visible = false end
        if data.Box then data.Box.Visible = false end
    end))
    PlayerData[ply] = data
end
IX.SetupPlayerESP = SetupPlayerESP

local function RemovePlayerESP(ply)
    local d = PlayerData[ply]
    if not d then return end
    CleanupPlayerData(d)
    PlayerData[ply] = nil
    AlertedPlayers[ply.UserId] = nil
    ThreatState[ply] = nil
end

for _, p in ipairs(Players:GetPlayers()) do task.spawn(SetupPlayerESP, p) end
Players.PlayerAdded:Connect(function(p) task.wait(0.3); SetupPlayerESP(p) end)
Players.PlayerRemoving:Connect(RemovePlayerESP)
LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
    for ply in pairs(PlayerData) do SetupPlayerESP(ply) end
end)

local function GetAimTarget()
    local Best, BestDist = nil, AIM_CONFIG.MaxCorrection * 1.5
    local CX = Camera.ViewportSize.X / 2
    local CY = Camera.ViewportSize.Y / 2
    for _, P in ipairs(Players:GetPlayers()) do
        if P == LocalPlayer then continue end
        if IsTeammate(P) then continue end
        if AIM_CONFIG.IgnoreFriends and P:IsFriendsWith(LocalPlayer.UserId) then continue end
        if not P.Character then continue end
        local C = P.Character
        local H = C:FindFirstChild("Humanoid")
        if not H or H.Health <= 0 then continue end
        local PN = AIM_CONFIG.AimPart
        PN = C:FindFirstChild("UpperTorso") and (PN == "Torso" and "UpperTorso" or PN) or (PN == "UpperTorso" and "Torso" or PN)
        local PT = C:FindFirstChild(PN) or C:FindFirstChild("Head")
        if not PT then continue end
        local Pos, OnS = Camera:WorldToViewportPoint(PT.Position)
        if not OnS then continue end
        local Dist = (Camera.CFrame.Position - PT.Position).Magnitude
        if Dist > AIM_CONFIG.MaxDistance then continue end
        local PX = math.sqrt((Pos.X - CX)^2 + (Pos.Y - CY)^2)
        local Ang = math.deg(math.atan(PX / math.max(Dist, 1)))
        if Ang > AIM_CONFIG.FOV then continue end
        if PX < BestDist then
            BestDist = PX
            Best = {Pos = PT.Position, HRP = C:FindFirstChild("HumanoidRootPart")}
        end
    end
    return Best
end

