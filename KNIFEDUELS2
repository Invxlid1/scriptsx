local CURRENT = {}

local function LoadOrCreateConfig()
    local loaded = nil
    if typeof(isfile) == "function" and isfile(CONFIG_FILE) then
        local ok, data = pcall(readfile, CONFIG_FILE)
        if ok and #data > 0 then
            local ok2, dec = pcall(function() return HttpService:JSONDecode(data) end)
            if ok2 and typeof(dec) == "table" then
                loaded = dec
            end
        end
    end
    for k, v in pairs(MASTER_DEFAULTS) do
        if loaded and loaded[k] ~= nil then
            CURRENT[k] = loaded[k]
        else
            CURRENT[k] = v
        end
    end
    local ok, data = pcall(function() return HttpService:JSONEncode(CURRENT) end)
    if ok and typeof(writefile) == "function" then
        pcall(writefile, CONFIG_FILE, data)
    end
end

local function SaveSettings()
    if typeof(writefile) == "function" then
        local ok, data = pcall(function() return HttpService:JSONEncode(CURRENT) end)
        if ok then
            pcall(writefile, CONFIG_FILE, data)
            return true
        end
    end
    return false
end

