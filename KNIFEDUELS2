local function MakeSlider(name, value, min, max, decimals, callback, y)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 50)
    container.Position = UDim2.new(0, 0, 0, y)
    container.BackgroundTransparency = 1
    container.Parent = ContentFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 22)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamSemibold
    label.Text = "   "..name.."    "..string.format("%."..decimals.."f", value)
    label.TextColor3 = ActiveTheme.Text
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    -- Bigger hit area for mobile
    local hitArea = Instance.new("Frame")
    hitArea.Size = UDim2.new(1, -20, 0, 20)
    hitArea.Position = UDim2.new(0, 10, 0, 26)
    hitArea.BackgroundColor3 = ActiveTheme.Element
    hitArea.BackgroundTransparency = 0.5
    hitArea.BorderSizePixel = 0
    Instance.new("UICorner", hitArea).CornerRadius = UDim.new(0, 6)
    hitArea.Parent = container

    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, -8, 0, 6)
    barBg.Position = UDim2.new(0, 4, 0.5, -3)
    barBg.BackgroundColor3 = ActiveTheme.Bg
    barBg.BackgroundTransparency = 0.5
    barBg.BorderSizePixel = 0
    barBg.ZIndex = 2
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 3)
    barBg.Parent = hitArea

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    barFill.BackgroundColor3 = ActiveTheme.Accent
    barFill.BackgroundTransparency = 0
    barFill.BorderSizePixel = 0
    barFill.ZIndex = 3
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 3)
    barFill.Parent = barBg

    local dragging = false
    local function UpdateFromX(x)
        local px = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
        local v = min + px * (max - min)
        v = tonumber(string.format("%."..decimals.."f", v))
        label.Text = "   "..name.."    "..string.format("%."..decimals.."f", v)
        barFill.Size = UDim2.new(px, 0, 1, 0)
        callback(v)
        SaveSettings()
    end

    local function beginSlider(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromX(input.Position.X)
        end
    end

    local function endSlider(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end

    local function moveSlider(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromX(input.Position.X)
        end
    end

    hitArea.InputBegan:Connect(beginSlider)
    hitArea.InputEnded:Connect(endSlider)
    UserInputService.InputChanged:Connect(moveSlider)

    return container
end

