local function lerpColor(a, b, t)
    return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

local function ApplyVisualTheme(themeName)
    CURRENT.Theme = themeName
    ActiveTheme = THEMES[themeName] or THEMES.NeonRed
    themeAnimTime = 0
    if not ActiveTheme.Animated then
        CURRENT.AccentColor = {
            r = ActiveTheme.Accent.R * 255,
            g = ActiveTheme.Accent.G * 255,
            b = ActiveTheme.Accent.B * 255
        }
    end
    if MainFrame then
        MainFrame.BackgroundColor3 = ActiveTheme.Bg
        MainStroke.Color = ActiveTheme.Accent
        MainGlow.Color = ActiveTheme.Accent
        if StatusBar then StatusBar.BackgroundColor3 = ActiveTheme.StatusBg end
    end
    SaveSettings()
    ShowNotification("🎨 Theme Changed", themeName .. " applied!", 2)
end

task.spawn(function()
    while true do
        local dt = RunService.Heartbeat:Wait()
        if ActiveTheme and ActiveTheme.Animated and MainFrame then
            themeAnimTime = themeAnimTime + dt * (ActiveTheme.AnimSpeed or 1)
            local newColor
            local mode = ActiveTheme.AnimMode or "Pulse"
            if mode == "Rainbow" then
                newColor = Color3.fromHSV((themeAnimTime * 0.2) % 1, 1, 1)
            elseif mode == "Pulse" then
                local t = (math.sin(themeAnimTime) + 1) / 2
                newColor = lerpColor(ActiveTheme.AnimColorA or ActiveTheme.Accent, ActiveTheme.AnimColorB or ActiveTheme.Accent, t)
            elseif mode == "Strobe" then
                local t = (math.floor(themeAnimTime * 2) % 2 == 0) and 0 or 1
                newColor = lerpColor(ActiveTheme.AnimColorA or ActiveTheme.Accent, ActiveTheme.AnimColorB or ActiveTheme.Accent, t)
            else
                newColor = ActiveTheme.Accent
            end
            ActiveTheme.Accent = newColor
            CURRENT.AccentColor = {r = newColor.R * 255, g = newColor.G * 255, b = newColor.B * 255}
            if MainStroke then MainStroke.Color = newColor end
            if MainGlow then MainGlow.Color = newColor end
        end
    end
end)

