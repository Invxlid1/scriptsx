            dir = (tp.Position - origin).Unit
            pcall(function() ActivateShroud:FireServer(origin, dir) end)
        else
            local s1, CRM = pcall(function()
                return require(ReplicatedStorage.Modules.CharacterRayOrigin)
            end)
            local s2, SPC = pcall(function()
                return require(ReplicatedStorage.Ability.ShroudProjectileController)
            end)
            if s1 and s2 then
                origin = CRM(c)
                dir = (tp.Position - origin).Unit
                pcall(function() ActivateShroud:FireServer(origin, dir) end)
                pcall(function() SPC(origin, dir) end)
            else
                getgenv().lowExecutorsShroud = true
