        }):OnChanged(function(v)
            getgenv().speed_enabled = v
            FeatureActivated(v)
            if v then
                task.spawn(function()
                    while getgenv().speed_enabled and getgenv().INVALIDX_EXEC_TOKEN == EXEC_TOKEN do
                        local c = Player.Character
                        local h = c and c:FindFirstChild("Humanoid")
                        if h and h.WalkSpeed ~= getgenv().current_speed then
                            h.WalkSpeed = getgenv().current_speed
                        end
                        task.wait(0.1)
                    end
                end)
            else
                local c = Player.Character
                local h = c and c:FindFirstChild("Humanoid")
                if h then h.WalkSpeed = getgenv().original_speed end
            end
