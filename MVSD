                    end
                    task.wait(0.1)
                end
            end)
        end)

    Tabs.Misc:AddToggle("AntiAFK", { Title = "Anti-AFK", Default = true,
        }):OnChanged(function(v)
            getgenv().antiafk = v
            if v then
                task.spawn(function()
