Tabs.FOV:AddSection("FOV Shooting")

local fov_autoshoot = false
local fov_manual = false
local fov_circle_on = false
local fov_radius = 100
local fov_cd = 1
local fov_last = 0
local fov_circle

local function createCircle()
    if fov_circle then pcall(function() fov_circle:Remove() end) end
    fov_circle = Drawing.new("Circle")
    fov_circle.Thickness = 2
    fov_circle.NumSides = 64
    fov_circle.Radius = fov_radius
    fov_circle.Color = Color3.fromRGB(255, 31, 61)
    fov_circle.Transparency = 1
    fov_circle.Visible = false
    fov_circle.Filled = false
end
createCircle()

local function updCircle()
    if fov_circle and (fov_circle_on or fov_autoshoot or fov_manual) then
        local mp = UserInputService:GetMouseLocation()
        fov_circle.Position = Vector2.new(mp.X, mp.Y)
        fov_circle.Radius = fov_radius
        fov_circle.Visible = true
    elseif fov_circle then
        fov_circle.Visible = false
    end
end

local function inFov(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    if not on then return false end
    local mp = UserInputService:GetMouseLocation()
    return math.sqrt((sp.X - mp.X)^2 + (sp.Y - mp.Y)^2) <= fov_radius
end

local function fovShoot(t)
    local myChar = Player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local thrp = t.Character and t.Character:FindFirstChild("HumanoidRootPart")
    if not (myRoot and thrp) then return false end
    if not hasClearLOS(myRoot.Position, thrp.Position, myChar, t.Character) then return false end
    if not inFov(thrp.Position) then return false end
    if tick() - fov_last < fov_cd then return false end
    local hp = t.Character:FindFirstChild("LowerTorso") or t.Character:FindFirstChild("UpperTorso") or t.Character:FindFirstChild("Head")
    if hp then ShootGun(t); fov_last = tick(); return true end
    return false
end

RunService.Heartbeat:Connect(function()
    updCircle()
    if not fov_autoshoot then return end
    for _, e in ipairs(Players:GetPlayers()) do
        if isValidEnemy(e) and fovShoot(e) then break end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if fov_manual and input.UserInputType == Enum.UserInputType.MouseButton1 then
        for _, e in ipairs(Players:GetPlayers()) do
