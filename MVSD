local function getGun()
    local character = Player.Character
    local places = { Player:FindFirstChild("Backpack") }
    if character then table.insert(places, character) end
    for _, container in ipairs(places) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tool:FindFirstChild("Fire") and tool:FindFirstChild("Reload") then
                    return tool
                end
            end
        end
    end
    return nil
end

local function getGunCooldown()
    local gun = getGun()
    if not gun then return 1.5 end
    local cd = gun:GetAttribute("Cooldown")
    if type(cd) == "number" then return cd + 0.15 end
    return 1.5
end

local function equipGun()
    local c = Player.Character
    local bp = Player:FindFirstChildOfClass("Backpack")
    if not c or not bp then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if getgenv().match then
        local gun = getGun()
        if gun then pcall(function() h:EquipTool(gun) end); return true end
    end
    return false
end

local function equipKnife()
    local c = Player.Character
    local bp = Player:FindFirstChildOfClass("Backpack")
    if not c or not bp then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if getgenv().match then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("EquipAnimation") == "Knife_Equip" then
                pcall(function() h:EquipTool(tool) end)
                return true
            end
        end
    end
    return false
end

local function CharacterRayOrigin(char)
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    return (hrp.CFrame * CFrame.new(0, 0, hrp.Size.Z / 2)).Position
end

local function hasClearLOS(fromPos, toPos, myChar, targetChar)
    if not (fromPos and toPos and myChar and targetChar) then return false end
    local p = RaycastParams.new()
    p.FilterDescendantsInstances = { myChar, targetChar }
    p.FilterType = Enum.RaycastFilterType.Exclude
    local r = workspace:Raycast(fromPos, (toPos - fromPos), p)
    if r and not r.Instance:IsDescendantOf(targetChar) then return false end
    return true
end

local function isValidEnemy(enemy)
    if not enemy then return false end
    if enemy == Player or enemy == Players.LocalPlayer then return false end
    local c = enemy.Character
    if not c or c.Parent ~= Workspace then return false end
    if c == Player.Character then return false end
    if enemy.Team and Player.Team and enemy.Team == Player.Team then return false end
    local h = c:FindFirstChild("Humanoid")
    if not h or h.Health <= 0 then return false end
    if Collection:HasTag(c, "Invulnerable") or Collection:HasTag(c, "SpeedTrail") then return false end
    return true
end

-- ═══════════════════════════════════════════════════════════════
--  BULLET TRACER
-- ═══════════════════════════════════════════════════════════════
local BulletRendererColor = Color3.fromRGB(255, 255, 255)
local function BulletRenderer(origin, targetPos)
    pcall(function()
        local function pp(cf)
            local p = Instance.new("Part")
            p.Size = Vector3.new(0.1,0.1,0.1)
            p.Transparency = 1; p.CanCollide = false; p.CanQuery = false
            p.CanTouch = false; p.Anchored = true; p.CFrame = cf
            p.Parent = workspace
            return p
        end
        local sP = pp(CFrame.lookAt(origin, targetPos) * CFrame.new(0, 0, -1))
        local eP = pp(CFrame.new(targetPos))
        local b = Instance.new("Beam")
        b.Texture = ""; b.TextureLength = 1
        b.TextureMode = Enum.TextureMode.Stretch; b.TextureSpeed = 0
        b.Color = ColorSequence.new(BulletRendererColor)
        b.LightEmission = 1; b.LightInfluence = 0; b.Brightness = 5
        b.Width0 = 0; b.Width1 = 0
        local a0 = Instance.new("Attachment", sP)
        local a1 = Instance.new("Attachment", eP)
        b.Attachment0 = a0; b.Attachment1 = a1; b.Parent = sP
        local fi = TweenService:Create(b, TweenInfo.new(0.05, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Width0=0.3, Width1=0.6})
        local fo = TweenService:Create(b, TweenInfo.new(0.1, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Width0=0, Width1=0})
        fi:Play()
        fi.Completed:Connect(function() fo:Play() end)
        Debris:AddItem(sP, 0.3); Debris:AddItem(eP, 0.3)
    end)
end

