    getgenv().INVALIDX_MVSD_LOADED = nil
    pcall(function()
        local abilityFolder = ReplicatedStorage:FindFirstChild("Ability")
        if abilityFolder then
            local ok, Config = pcall(function() return require(abilityFolder.AbilityConfig) end)
            if ok and Config then
                Config.SprintCooldown = 15
                Config.DashCooldown = 6
                Config.ShroudCooldown = 7
                Config.SoulReapCombatDelay = 0.35
            end
        end
    end)
    for t, cd in pairs(getgenv().original_cooldowns or {}) do
        if t and t.Parent then pcall(function() t:SetAttribute("Cooldown", cd) end) end
    end
    pcall(function()
        local a = CoreGui:FindFirstChild("InvalidX_ESP"); if a then a:Destroy() end
        local b = CoreGui:FindFirstChild("InvalidX_Skeletons"); if b then b:Destroy() end
        local c = CoreGui:FindFirstChild("InvalidX_Tracers"); if c then c:Destroy() end
    end)
    if getgenv().INVALIDX_FOV_GUI then
        pcall(function() getgenv().INVALIDX_FOV_GUI:Destroy() end)
    end
    pcall(function() Window:Destroy() end)
    print("[InvalidX] Unloaded.")
end

