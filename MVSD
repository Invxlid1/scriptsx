getgenv().silent_aim_enabled = false
getgenv().silent_aim_fov = 200
getgenv().silent_aim_distance = 500
getgenv().silent_aim_target_part = "Head"
getgenv().silent_aim_ignore_friends = true
getgenv().INVALIDX_SILENT_TARGET = nil

local function getSilentAimTarget()
    if not getgenv().silent_aim_enabled then return nil end
    return getgenv().INVALIDX_SILENT_TARGET
end

local function ShootGun(target)
    local silent = getSilentAimTarget()
    if silent then target = silent end
    if not target then return end
    if target == Player or target == Players.LocalPlayer then return end
    local myChar = Player.Character
    if not myChar then return end
    local origin = CharacterRayOrigin(myChar)
    if not origin then return end
    local tgtChar = target.Character
    if not tgtChar or tgtChar == myChar then return end
    local hitPart
    if silent and silent == target then
        hitPart = tgtChar:FindFirstChild(getgenv().silent_aim_target_part)
            or tgtChar:FindFirstChild("Head")
            or tgtChar:FindFirstChild("HumanoidRootPart")
    else
        hitPart = tgtChar:FindFirstChild("Head") or tgtChar:FindFirstChild("HumanoidRootPart")
    end
    if not hitPart then return end
    local tool = getGun()
    if not tool then return end
    canShoot = false
    local targetPos = hitPart.Position
    local muzzle = tool:FindFirstChild("Muzzle", true)
    local startPos = muzzle and muzzle.WorldPosition or origin
    BulletRenderer(startPos, targetPos)
    pcall(function()
        ReplicatedStorage.Remotes.ShootGun:FireServer(origin, targetPos, hitPart, targetPos)
    end)
    local s = tool:FindFirstChild("Fire")
    if s and s:IsA("Sound") then pcall(function() s:Play() end) end
    task.delay(getGunCooldown(), function() canShoot = true end)
end

