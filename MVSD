    Tabs.Aim:AddToggle("SilentAim", { Title = "Enable Silent Aim", Default = false,
        }):OnChanged(function(v) getgenv().silent_aim_enabled = v; FeatureActivated(v) end)
    Tabs.Aim:AddSlider("SAFOV", { Title = "Aim FOV", Min = 50, Max = 1000, Default = 200, Rounding = 0,
        }):OnChanged(function(v) getgenv().silent_aim_fov = tonumber(v) or 200 end)
    Tabs.Aim:AddSlider("SADist", { Title = "Max Distance", Min = 100, Max = 2000, Default = 500, Rounding = 0,
        }):OnChanged(function(v) getgenv().silent_aim_distance = tonumber(v) or 500 end)
    Tabs.Aim:AddDropdown("SATarget", {
        Title = "Target Part",
        Values = {"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"},
        Default = 1, Multi = false,
    }):OnChanged(function(v) getgenv().silent_aim_target_part = v end)
    Tabs.Aim:AddToggle("SAIgnoreFriends", { Title = "Ignore Friends", Default = true,
        }):OnChanged(function(v) getgenv().silent_aim_ignore_friends = v end)

    task.spawn(function()
        while getgenv().INVALIDX_EXEC_TOKEN == EXEC_TOKEN do
            task.wait(0.05)
            if getgenv().silent_aim_enabled and getgenv().match then
                local myChar = Player.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myRoot and Camera then
                    local mp = UserInputService:GetMouseLocation()
                    local best, bestD = nil, tonumber(getgenv().silent_aim_fov) or 200
                    local maxDist = tonumber(getgenv().silent_aim_distance) or 500
                    for _, p in ipairs(matchEnemies) do
                        if isValidEnemy(p) then
                            local skip = false
                            if getgenv().silent_aim_ignore_friends then
                                local ok, f = pcall(function() return p:IsFriendsWith(Player.UserId) end)
                                if ok and f then skip = true end
                            end
                            if not skip then
                                local tp = p.Character:FindFirstChild(getgenv().silent_aim_target_part)
                                    or p.Character:FindFirstChild("HumanoidRootPart")
                                if tp then
                                    local d = (tp.Position - myRoot.Position).Magnitude
                                    if d > 5 and d <= maxDist then
                                        local sp, on = Camera:WorldToViewportPoint(tp.Position)
                                        if on then
                                            local dd = math.sqrt((sp.X - mp.X)^2 + (sp.Y - mp.Y)^2)
                                            if dd < bestD then bestD = dd; best = p end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    getgenv().INVALIDX_SILENT_TARGET = best
                else
                    getgenv().INVALIDX_SILENT_TARGET = nil
                end
            else
                getgenv().INVALIDX_SILENT_TARGET = nil
            end
        end
    end)
end)

