Tabs.Teleport:AddSection("Auto Walk")

local lobby = workspace:WaitForChild("Lobby")
local groups = { DuelRing_1v1 = 1, DuelRing_2v2 = 2, DuelRing_3v3 = 3, DuelRing_4v4 = 4 }
local autoWalkToDuelPad = false
local currentPadModel = nil
local lastJumpTime = 0

local function walkTo(model)
    local c = Player.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    local rp = c:FindFirstChild("HumanoidRootPart")
    if hum and rp and model and model.PrimaryPart then
        local tp = model.PrimaryPart.Position
        local d = (rp.Position - tp).Magnitude
        if d <= 6 then
            getgenv().noclip = false
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
            return
        end
        hum.WalkSpeed = 35
        hum:MoveTo(tp)
        if os.clock() - lastJumpTime >= 2 then hum.Jump = true; lastJumpTime = os.clock() end
        getgenv().noclip = true
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end

Tabs.Teleport:AddToggle("AutoWalk", { Title = "Auto Walk to Duel Pads", Default = false,
    }):OnChanged(function(v) autoWalkToDuelPad = v; FeatureActivated(v) end)

task.spawn(function()
    while getgenv().INVALIDX_EXEC_TOKEN == EXEC_TOKEN do
        task.wait(0.2)
        if not Player:GetAttribute("Match") and autoWalkToDuelPad then
            local c = Player.Character
            local rp = c and c:FindFirstChild("HumanoidRootPart")
            if currentPadModel and rp then
                local currentMax = 1
                for gName, mx in pairs(groups) do
                    if lobby:FindFirstChild("DuelRingsGroup") and lobby.DuelRingsGroup:FindFirstChild(gName) then
                        if lobby.DuelRingsGroup[gName]:FindFirstChild(currentPadModel.Name) then
                            currentMax = mx; break
                        end
                    end
                end
                if currentMax == 1 then
                    local found = false
                    for _, op in ipairs(Players:GetPlayers()) do
                        if op ~= Player and op.Character then
                            local oh = op.Character:FindFirstChild("HumanoidRootPart")
                            if oh and (rp.Position - oh.Position).Magnitude <= 8 then found = true; break end
                        end
                    end
                    if not found then currentPadModel = nil end
                end
            end
            if not currentPadModel then
                for _, gf in ipairs(lobby:GetChildren()) do
                    if gf.Name == "DuelRingsGroup" then
                        for gName, mx in pairs(groups) do
                            local rf = gf:FindFirstChild(gName)
                            if rf then
                                local pads, total = {}, 0
                                local maxP = mx * 2
                                for _, m in ipairs(rf:GetChildren()) do
                                    if m:IsA("Model") and m.Name == "DuelPad" then
                                        local cnt = m:GetAttribute("CharacterCount") or 0
                                        total = total + cnt
                                        table.insert(pads, {model = m, count = cnt})
                                    end
                                end
                                if total == maxP - 1 then
                                    for _, pad in ipairs(pads) do
                                        if pad.count < mx then
                                            local oppReady = true
                                            if mx == 1 then
                                                oppReady = false
                                                for _, op in ipairs(Players:GetPlayers()) do
                                                    if op ~= Player and op.Character and pad.model.PrimaryPart then
                                                        local oh = op.Character:FindFirstChild("HumanoidRootPart")
                                                        if oh and (oh.Position - pad.model.PrimaryPart.Position).Magnitude <= 8 then
                                                            oppReady = true; break
                                                        end
                                                    end
                                                end
                                            end
                                            if oppReady then
                                                walkTo(pad.model)
                                                if rp and pad.model.PrimaryPart then
                                                    if (rp.Position - pad.model.PrimaryPart.Position).Magnitude <= 6 then
                                                        currentPadModel = pad.model
                                                    end
                                                end
                                                break
                                            end
                                        end
                                    end
