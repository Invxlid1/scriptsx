--  FOV TAB  (GuiObject circle, self-safe targeting)
-- ═══════════════════════════════════════════════════════════════
safeBuild("FOV", function()
    Tabs.FOV:AddSection("FOV Shooting")

    local fov_autoshoot = false
    local fov_manual = false
    local fov_circle_on = false
    local fov_radius = 100
    local fov_cd = 2
    local fov_last = 0
    local anchor_mode = "Mouse"

    local circleGui = Instance.new("ScreenGui")
    circleGui.Name = "InvalidX_FOVCircle"
    circleGui.ResetOnSpawn = false
    circleGui.IgnoreGuiInset = true
    circleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    circleGui.DisplayOrder = 100
    circleGui.Parent = CoreGui

    local circleFrame = Instance.new("Frame", circleGui)
    circleFrame.BackgroundTransparency = 1
    circleFrame.BorderSizePixel = 0
    circleFrame.Visible = false
    circleFrame.AnchorPoint = Vector2.new(0.5, 0.5)

    local corner = Instance.new("UICorner", circleFrame)
    corner.CornerRadius = UDim.new(0.5, 0)

    local stroke = Instance.new("UIStroke", circleFrame)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(255, 31, 61)
    stroke.Transparency = 0

    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            mousePos = Vector2.new(input.Position.X, input.Position.Y)
        end
    end)
    pcall(function()
        local mp = UserInputService:GetMouseLocation()
        if mp and mp.X and mp.Y and mp.X > 0 and mp.Y > 0 then
            mousePos = Vector2.new(mp.X, mp.Y)
        end
    end)

    local function getAnchor()
        if anchor_mode == "Center" then
            return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        end
        return mousePos
    end

    local function updateCircle()
        if not circleFrame then return end
        local visible = fov_circle_on or fov_autoshoot or fov_manual
        circleFrame.Visible = visible
        if not visible then return end
        local r = tonumber(fov_radius) or 100
        circleFrame.Size = UDim2.fromOffset(r * 2, r * 2)
        local a = getAnchor()
        circleFrame.Position = UDim2.fromOffset(a.X, a.Y)
    end

    local function inFov(pos)
        local sp, on = Camera:WorldToViewportPoint(pos)
        if not on then return false end
        local a = getAnchor()
        local r = tonumber(fov_radius) or 100
        return math.sqrt((sp.X - a.X)^2 + (sp.Y - a.Y)^2) <= r
    end

    local function fovValidEnemy(e)
        if not e then return false end
        if e == Player or e == Players.LocalPlayer then return false end
        local c = e.Character
        if not c or c == Player.Character then return false end
        local h = c:FindFirstChild("Humanoid")
        if not h or h.Health <= 0 then return false end
        if e.Team and Player.Team and e.Team == Player.Team then return false end
        if Collection:HasTag(c, "Invulnerable") or Collection:HasTag(c, "SpeedTrail") then return false end
        return true
    end

    local function fovShoot(t)
        if not t or t == Player or t == Players.LocalPlayer then return false end
        local myChar = Player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local thrp = t.Character and t.Character:FindFirstChild("HumanoidRootPart")
        if not (myRoot and thrp) then return false end
        local dist = (thrp.Position - myRoot.Position).Magnitude
        if dist < 5 then return false end
        if not hasClearLOS(myRoot.Position, thrp.Position, myChar, t.Character) then return false end
        if not inFov(thrp.Position) then return false end
        local cd = tonumber(fov_cd) or 2
        if tick() - fov_last < cd then return false end
        local hp = t.Character:FindFirstChild("LowerTorso")
            or t.Character:FindFirstChild("UpperTorso")
            or t.Character:FindFirstChild("Head")
        if hp then ShootGun(t); fov_last = tick(); return true end
        return false
    end

    RunService.RenderStepped:Connect(function() pcall(updateCircle) end)

    RunService.Heartbeat:Connect(function()
        if not fov_autoshoot then return end
        for _, e in ipairs(Players:GetPlayers()) do
            if fovValidEnemy(e) and fovShoot(e) then break end
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if fov_manual and input.UserInputType == Enum.UserInputType.MouseButton1 then
            for _, e in ipairs(Players:GetPlayers()) do
                if fovValidEnemy(e) and fovShoot(e) then break end
            end
        end
    end)

    Tabs.FOV:AddToggle("FovCircle", { Title = "Show FOV Circle", Default = false,
        }):OnChanged(function(v) fov_circle_on = v end)
    Tabs.FOV:AddDropdown("FovAnchor", {
        Title = "Circle Anchor",
        Values = {"Mouse", "Center"},
        Default = 1, Multi = false,
    }):OnChanged(function(v) anchor_mode = v end)
    Tabs.FOV:AddToggle("FovAuto", { Title = "Auto Shoot FOV", Default = false,
        }):OnChanged(function(v) fov_autoshoot = v; FeatureActivated(v) end)
    Tabs.FOV:AddToggle("FovManual", { Title = "Manual Shoot FOV", Default = false,
        }):OnChanged(function(v) fov_manual = v; FeatureActivated(v) end)
    Tabs.FOV:AddSlider("FovRadius", { Title = "FOV Radius", Min = 35, Max = 300, Default = 100, Rounding = 0,
        }):OnChanged(function(v) fov_radius = tonumber(v) or 100 end)
    Tabs.FOV:AddSlider("FovCD", { Title = "FOV Cooldown", Min = 0, Max = 5, Default = 2, Rounding = 1,
        }):OnChanged(function(v) fov_cd = tonumber(v) or 2 end)

    getgenv().INVALIDX_FOV_GUI = circleGui
end)

