local function blind(targetPlayer)
    local c = Player.Character
    if targetPlayer and targetPlayer.Character and c then
        local tp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local root = c:FindFirstChild("HumanoidRootPart")
        if tp and root then
            local origin, dir
            if getgenv().lowExecutorsShroud then
                origin = root.Position
                dir = (tp.Position - origin).Unit
                ActivateShroud:FireServer(origin, dir)
            else
                local s1, CRM = pcall(function() return require(ReplicatedStorage.Modules.CharacterRayOrigin) end)
                local s2, SPC = pcall(function() return require(ReplicatedStorage.Ability.ShroudProjectileController) end)
                if s1 and s2 then
                    origin = CRM(c)
                    dir = (tp.Position - origin).Unit
                    ActivateShroud:FireServer(origin, dir)
                    SPC(origin, dir)
                else
                    getgenv().lowExecutorsShroud = true
                    origin = root.Position
                    dir = (tp.Position - origin).Unit
                    ActivateShroud:FireServer(origin, dir)
                end
            end
        end
    end
end

