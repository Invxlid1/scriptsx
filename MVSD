    }

    local function blind(targetPlayer)
        if not ActivateShroud then return end
        local c = Player.Character
        if not (targetPlayer and targetPlayer.Character and c) then return end
        local tp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local root = c:FindFirstChild("HumanoidRootPart")
        if not (tp and root) then return end
        local origin, dir
        if getgenv().lowExecutorsShroud then
