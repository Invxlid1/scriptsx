getgenv().auto_throw_enabled = false
getgenv().throw_distance = 300       -- separate
getgenv().throw_cooldown = 2
local autoThrowThread
local lastThrowTime = 0

local function throwKnife(targetChar)
    local tool = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
    if not tool or not tool:FindFirstChild("RightHandle") then return end
    local tgtHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not tgtHrp then return end
    local origin = CharacterRayOrigin(Player.Character)
    if not origin then return end
    local dir = (tgtHrp.Position - origin).Unit
    ReplicatedStorage.Remotes.ThrowStart:FireServer(origin, dir)
    local ok, ctrl = pcall(function() return require(ReplicatedStorage.Modules.KnifeProjectileController) end)
    if ok and ctrl then
        ctrl({
            Speed = tool:GetAttribute("ThrowSpeed"),
            KnifeProjectile = tool.RightHandle:Clone(),
            Direction = dir,
            Origin = origin,
        }, function(r)
            ReplicatedStorage.Remotes.ThrowHit:FireServer(r and r.Instance, r and r.Position)
        end)
    end
    lastThrowTime = tick()
end

Tabs.Main:AddToggle("AutoThrow", {
    Title = "Enable Auto Throw Knife",
    Description = "Throws knife at enemies in line of sight",
    Default = false,
}):OnChanged(function(v)
    getgenv().auto_throw_enabled = v
    FeatureActivated(v)
    if autoThrowThread then task.cancel(autoThrowThread); autoThrowThread = nil end
    if v then
        autoThrowThread = task.spawn(function()
            while getgenv().auto_throw_enabled and getgenv().INVALIDX_EXEC_TOKEN == EXEC_TOKEN do
                if (tick() - lastThrowTime) >= getgenv().throw_cooldown then
                    local myChar = Player.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local best, bestD = nil, getgenv().throw_distance
                        for _, p in ipairs(matchEnemies) do
                            if p ~= Player and p.Character and p.Team ~= Player.Team then
                                local eh = p.Character:FindFirstChild("HumanoidRootPart")
                                local eh2 = p.Character:FindFirstChild("Humanoid")
                                if eh and eh2 and eh2.Health > 0 then
                                    local d = (eh.Position - myRoot.Position).Magnitude
                                    local p2 = RaycastParams.new()
                                    p2.FilterDescendantsInstances = {myChar, p.Character}
                                    p2.FilterType = Enum.RaycastFilterType.Exclude
                                    local r = workspace:Raycast(myRoot.Position, eh.Position - myRoot.Position, p2)
                                    if d < bestD and not r then bestD = d; best = p.Character end
                                end
                            end
                        end
                        if best then throwKnife(best) end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

