local function ensureEffect(name, className)
    if effects[name] and effects[name].Parent then return effects[name] end
    local e = Instance.new(className)
    e.Name = "InvalidX_" .. name
    e.Parent = Lighting
    effects[name] = e
    return e
end

local function applyBloom()
    if not CONFIG.BloomEnabled then
        if effects.Bloom then effects.Bloom:Destroy(); effects.Bloom = nil end
        return
    end
    local b = ensureEffect("Bloom", "BloomEffect")
    local m = CONFIG.MasterIntensity
    tweenProp(b, "Intensity", CONFIG.BloomIntensity * m, 0.5)
    tweenProp(b, "Size", CONFIG.BloomSize, 0.5)
    tweenProp(b, "Threshold", CONFIG.BloomThreshold, 0.5)
end

local function applyCC()
    if not CONFIG.CCEnabled then
        if effects.CC then effects.CC:Destroy(); effects.CC = nil end
        return
