local function analyzeGame()
    -- 1. Check PlaceId lookup
    local preset = GAME_PRESET_MAP[game.PlaceId]
    if preset then return preset, "PlaceId match" end

    -- 2. Check by name
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if ok and info and info.Name then
        local n = info.Name:lower()
        if n:find("anime") or n:find("fruit") or n:find("naruto") or n:find("dragon ball") then
            return "Anime", "Name match: anime"
        elseif n:find("horror") or n:find("scary") or n:find("fnaf") then
            return "Horror", "Name match: horror"
        elseif n:find("snow") or n:find("winter") or n:find("ice") then
            return "Arctic", "Name match: arctic"
        elseif n:find("desert") or n:find("sand") then
            return "Desert", "Name match: desert"
        elseif n:find("neon") or n:find("cyber") or n:find("city") then
            return "Neon City", "Name match: neon"
        elseif n:find("retro") or n:find("80s") or n:find("vhs") then
            return "Retro VHS", "Name match: retro"
        elseif n:find("mansion") or n:find("haunted") then
            return "Horror", "Name match: horror"
        end
    end

    -- 3. Analyze Lighting environment
    local hour = Lighting.ClockTime
    local hasAtmos = Lighting:FindFirstChildOfClass("Atmosphere") ~= nil
    local ambientBrightness = Lighting.Brightness

    if hour >= 20 or hour <= 5 then
        return "Moonlit", "Time: night"
    elseif hour >= 16 and hour <= 19 then
        return "Golden Hour", "Time: sunset"
    end

    if ambientBrightness < 1 then
        return "Ultra Realistic", "Dark game detected"
    elseif ambientBrightness > 3 then
        return "Vibrant", "Bright game detected"
    end

    return "Ultra Realistic", "Default"
end

local function autoApplyGamePreset()
    local preset, reason = analyzeGame()
    if preset then
        applyBuiltin(preset, true)
        notify("Auto-Preset", preset .. " (" .. reason .. ")", 4)
    end
end

