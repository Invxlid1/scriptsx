local function clearWeatherObjects()
    for _, obj in ipairs(weatherObjects) do
        pcall(function() obj:Destroy() end)
    end
    weatherObjects = {}
end

local function makeWeatherPart()
    local part = Instance.new("Part")
    part.Size = Vector3.new(160, 1, 160)
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Parent = workspace
    return part
end

local function followPlayer(part)
    -- constantly keep part above player
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not part or not part.Parent then
            if conn then conn:Disconnect() end
            return
        end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            part.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 40, 0))
        end
    end)
    table.insert(weatherObjects, conn)  -- cleanup on change
    return conn
end

local function makeSound3D(id, volume, looped, attachedTo)
    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = volume or 0.5
    sound.Looped = looped ~= false
    sound.PlayOnRemove = false
    if attachedTo then
        sound.Parent = attachedTo
    else
        sound.Parent = SoundService
    end
    sound:Play()
    return sound
end

