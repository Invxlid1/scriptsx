local function sliderRow(parent, label, key, min, max, dec)
    dec = dec or 2
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundColor3 = Color3.fromRGB(26,20,38)
    row.BackgroundTransparency = 0.15
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -20, 0, 16)
    lbl.Position = UDim2.new(0, 12, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextColor3 = Color3.fromRGB(230,230,245)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = label .. ": " .. string.format("%."..dec.."f", CONFIG[key])

    local bg = Instance.new("Frame", row)
    bg.Size = UDim2.new(1, -24, 0, 10)
    bg.Position = UDim2.new(0, 12, 0, 26)
    bg.BackgroundColor3 = Color3.fromRGB(45,35,60)
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 5)

    local fill = Instance.new("Frame", bg)
    local pct = (CONFIG[key] - min) / (max - min)
    fill.Size = UDim2.new(math.clamp(pct,0,1), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(180,80,255)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 5)

    local dragging = false
    local function update(x)
        local px = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local v = min + px * (max - min)
        v = tonumber(string.format("%."..dec.."f", v))
        CONFIG[key] = v
        lbl.Text = label .. ": " .. string.format("%."..dec.."f", v)
        fill.Size = UDim2.new(px, 0, 1, 0)
        applyAll()
        if key == "MaterialBoostAmount" then applyMaterialBoost() end
    end
    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(i.Position.X)
        end
    end)
    bg.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end)
    return row
end

