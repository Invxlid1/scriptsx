local function applySky()
    local existing = Lighting:FindFirstChildOfClass("Sky")
    if not CONFIG.SkyEnabled then
        if existing and existing.Name == "InvalidX_Sky" then
            existing:Destroy()
            if saved.Sky then saved.Sky:Clone().Parent = Lighting end
        end
        return
