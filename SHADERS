local function notify(title, message, duration)
    duration = duration or 3
    if not notifGui then
        notifGui = Instance.new("ScreenGui")
        notifGui.Name = "InvalidX_ShaderNotif"
        notifGui.ResetOnSpawn = false
        notifGui.Parent = CoreGui
        notifGui.DisplayOrder = 9999
    end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 320, 0, 80)
    frame.Position = UDim2.new(1, 20, 0, 25)
    frame.BackgroundColor3 = Color3.fromRGB(12, 10, 20)
    frame.BackgroundTransparency = 0.08
    frame.BorderSizePixel = 0
    frame.Parent = notifGui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(180, 80, 255)

    local t = Instance.new("TextLabel", frame)
    t.Size = UDim2.new(1, -20, 0, 24)
    t.Position = UDim2.new(0, 12, 0, 8)
    t.BackgroundTransparency = 1
    t.Font = Enum.Font.GothamBold
    t.Text = "✨ " .. title
    t.TextColor3 = Color3.fromRGB(255, 255, 255)
    t.TextSize = 15
    t.TextXAlignment = Enum.TextXAlignment.Left

    local m = Instance.new("TextLabel", frame)
    m.Size = UDim2.new(1, -20, 0, 34)
    m.Position = UDim2.new(0, 12, 0, 36)
    m.BackgroundTransparency = 1
    m.Font = Enum.Font.Gotham
    m.Text = message
    m.TextColor3 = Color3.fromRGB(200, 200, 220)
    m.TextSize = 12
    m.TextWrapped = true
    m.TextXAlignment = Enum.TextXAlignment.Left

    TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        Position = UDim2.new(1, -340, 0, 25)
    }):Play()

    task.delay(duration, function()
        TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Position = UDim2.new(1, 20, 0, 25)
        }):Play()
        task.wait(0.35)
        frame:Destroy()
    end)
end

