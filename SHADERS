local function lerpC(a,b,t) return Color3.new(a.R+(b.R-a.R)*t,a.G+(b.G-a.G)*t,a.B+(b.B-a.B)*t) end
local function lerpN(a,b,t) return a+(b-a)*t end

local function getBlend(hour)
    hour = hour % 24
    local before, after
    for i = 1, #KEYFRAMES - 1 do
        if hour >= KEYFRAMES[i][1] and hour <= KEYFRAMES[i+1][1] then
            before = KEYFRAMES[i]; after = KEYFRAMES[i+1]; break
        end
    end
    if not before then before = KEYFRAMES[#KEYFRAMES]; after = KEYFRAMES[1]; hour = hour + 24 end
    local span = after[1] - before[1]; if span <= 0 then span = 1 end
    local t = (hour - before[1]) / span
    return {
        Density = lerpN(before[2], after[2], t),
        Haze    = lerpN(before[3], after[3], t),
        Glare   = lerpN(before[4], after[4], t),
        AtmColor= lerpC(before[5], after[5], t),
        AtmDecay= lerpC(before[6], after[6], t),
        TintColor = lerpC(before[10], after[10], t),
    }
end

