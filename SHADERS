local function tweenProp(inst, prop, target, dur, style)
    if not inst then return end
    local cur = inst[prop]
    if typeof(cur) == "Color3" and typeof(target) == "Color3" then
        if (cur.R-target.R)^2+(cur.G-target.G)^2+(cur.B-target.B)^2 < 0.0001 then return end
    elseif typeof(cur) == "number" and typeof(target) == "number" then
        if math.abs(cur-target) < 0.001 then return end
    end
    pcall(function()
        TweenService:Create(inst, TweenInfo.new(dur or 0.6, style or Enum.EasingStyle.Quad), {[prop] = target}):Play()
    end)
end

-- ============================================================
--  DISABLE MAP LIGHTING
-- ============================================================
local function disableMapLighting()
    disabledMapEffects = {}
    for _, child in ipairs(Lighting:GetChildren()) do
        if (child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("Clouds"))
            and not child.Name:match("^InvalidX_") then
            table.insert(disabledMapEffects, {obj = child, wasEnabled = child.Enabled})
            child.Enabled = false
        end
    end
    notify("Map Lighting", "Disabled " .. #disabledMapEffects .. " map effects", 3)
end

local function restoreMapLighting()
    for _, data in ipairs(disabledMapEffects) do
        pcall(function() data.obj.Enabled = data.wasEnabled end)
    end
    disabledMapEffects = {}
end

