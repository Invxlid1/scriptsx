    local c = ensureEffect("CC", "ColorCorrectionEffect")
    local m = CONFIG.MasterIntensity
    tweenProp(c, "Brightness", CONFIG.CCBrightness * m, 0.5)
    tweenProp(c, "Contrast", CONFIG.CCContrast * m, 0.5)
    tweenProp(c, "Saturation", CONFIG.CCSaturation * m, 0.5)
    tweenProp(c, "TintColor", CONFIG.CCTint, 0.7)
end

