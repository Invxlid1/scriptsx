--  PANIC
-- ============================================================
local function panicRestore()
    panicking = true
    _G.INVALIDX_SHADER_LOADED = false

    restoreMapLighting()
    clearWeatherObjects()
    for _, e in pairs(effects) do pcall(function() e:Destroy() end) end
    effects = {}

    for part, orig in pairs(boostedParts) do
        pcall(function() part.Reflectance = orig end)
    end
    boostedParts = {}

    pcall(function()
        Lighting.Ambient = saved.Lighting.Ambient
        Lighting.OutdoorAmbient = saved.Lighting.OutdoorAmbient
        Lighting.Brightness = saved.Lighting.Brightness
        Lighting.ShadowSoftness = saved.Lighting.ShadowSoftness
        Lighting.GlobalShadows = saved.Lighting.GlobalShadows
        Lighting.EnvironmentDiffuseScale = saved.Lighting.EnvironmentDiffuseScale
        Lighting.EnvironmentSpecularScale = saved.Lighting.EnvironmentSpecularScale
        Lighting.ExposureCompensation = saved.Lighting.ExposureCompensation
        Lighting.ClockTime = saved.Lighting.ClockTime
        Lighting.FogEnd = saved.Lighting.FogEnd
        Lighting.FogStart = saved.Lighting.FogStart
        Lighting.FogColor = saved.Lighting.FogColor
        Terrain.WaterReflectance = saved.Terrain.WaterReflectance
        Terrain.WaterTransparency = saved.Terrain.WaterTransparency
        Terrain.WaterWaveSize = saved.Terrain.WaterWaveSize
        Terrain.WaterWaveSpeed = saved.Terrain.WaterWaveSpeed
        SoundService.AmbientReverb = saved.Sound.AmbientReverb
        SoundService.DistanceFactor = saved.Sound.DistanceFactor
        SoundService.DopplerScale = saved.Sound.DopplerScale
        SoundService.RolloffScale = saved.Sound.RolloffScale
    end)

    local sky = Lighting:FindFirstChild("InvalidX_Sky")
    if sky then
        sky:Destroy()
        if saved.Sky then saved.Sky:Clone().Parent = Lighting end
    end
    local clouds = Lighting:FindFirstChildOfClass("Clouds")
    if clouds and saved.Clouds then
        clouds.Cover = saved.Clouds.Cover
        clouds.Density = saved.Clouds.Density
        clouds.Color = saved.Clouds.Color
    end

    if UI then UI:Destroy() end
    if notifGui then notifGui:Destroy() end
    print("[InvalidX Shaders v5.0] Restored.")
end

getgenv().InvalidX_Shader_Unload = panicRestore

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.P and not panicking then
        panicRestore()
    elseif input.KeyCode == Enum.KeyCode.RightControl then
        uiVisible = not uiVisible
        main.Visible = uiVisible
        restoreBtn.Visible = not uiVisible
    end
end)

