local AlertedPlayers = {}

local function CheckPlayerStats(ply)
    if ply == LocalPlayer then return end
    if AlertedPlayers[ply.UserId] then return end

    task.wait(1.5)

    local leaderstats = ply:FindFirstChild("leaderstats")
    if not leaderstats then return end

    local Level     = leaderstats:FindFirstChild("Level")
    local Winstreak = leaderstats:FindFirstChild("Winstreak")

    local levelVal  = Level and Level.Value or 0
    local streakVal = Winstreak and Winstreak.Value or 0

    local levelHit  = CURRENT.AlertHighLevel  and levelVal  >= CURRENT.AlertLevelThreshold
    local streakHit = CURRENT.AlertHighStreak and streakVal >= CURRENT.AlertStreakThreshold

    if levelHit or streakHit then
        AlertedPlayers[ply.UserId] = true
        local msg = {}
        if levelHit  then table.insert(msg, "Lv."..levelVal) end
        if streakHit then table.insert(msg, "Streak "..streakVal) end
        ShowNotification("⚠️ HIGH THREAT: "..ply.Name, table.concat(msg, " | "), 5)
    end
end

