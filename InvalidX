RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera

    if AIM_Enabled then
        local T = GetAimTarget()
        if T then
            local P = T.Pos
            if AIM_CONFIG.Predict and T.HRP then
                P += T.HRP.Velocity * 0.045
            end
            local SP, OnS = Camera:WorldToViewportPoint(P)
            if OnS then
                local CX = Camera.ViewportSize.X / 2
                local CY = Camera.ViewportSize.Y / 2
                local Ox = SP.X - CX
                local Oy = SP.Y - CY
                local D  = math.sqrt(Ox^2 + Oy^2)
                local M  = AIM_CONFIG.MaxCorrection
                if D > M then
                    local S = M / D
                    Ox *= S
                    Oy *= S
                end
                local Ray = Camera:ViewportPointToRay(CX + Ox, CY + Oy)
                Camera.CFrame = Camera.CFrame:Lerp(
                    CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Ray.Direction * 500),
                    AIM_CONFIG.Smoothness
                )
            end
        end
    end

    if ESP_Enabled then
        for ply, data in pairs(PlayerData) do
            if ply == LocalPlayer then continue end
            local c = data.Char
            if not c or not c.Parent then
                for _, l in ipairs(data.Lines) do l.Visible = false end
                if data.Tracer then data.Tracer.Visible = false end
                if data.Info   then data.Info.Visible   = false end
                if data.Box    then data.Box.Visible    = false end
                continue
            end
            local hrp = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChild("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                for _, l in ipairs(data.Lines) do l.Visible = false end
                if data.Tracer then data.Tracer.Visible = false end
                if data.Info   then data.Info.Visible   = false end
                if data.Box    then data.Box.Visible    = false end
                continue
            end
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > CURRENT.MaxDistance then
                for _, l in ipairs(data.Lines) do l.Visible = false end
                if data.Tracer then data.Tracer.Visible = false end
                if data.Info   then data.Info.Visible   = false end
                if data.Box    then data.Box.Visible    = false end
                continue
            end
            local team  = IsTeammate(ply)
            local color = GetESPColor(team)
            local mode  = CURRENT.ESP_Mode

            local function W2D(pos)
                local v, onscr = Camera:WorldToViewportPoint(pos)
                return Vector2.new(v.X, v.Y), onscr, v.Z
            end

            local HRP2D, onscr, z = W2D(hrp.Position)
            if not onscr or z < 0 then
                for _, l in ipairs(data.Lines) do l.Visible = false end
                if data.Tracer then data.Tracer.Visible = false end
                if data.Info   then data.Info.Visible   = false end
                if data.Box    then data.Box.Visible    = false end
                continue
            end

            if mode == "Skeleton" or mode == "Both" then
                for i, j in ipairs(data.Joints) do
                    local l = data.Lines[i]
                    if l and j.From and j.To then
                        local p1, a1 = W2D(j.From.Position)
                        local p2, a2 = W2D(j.To.Position)
                        if a1 and a2 then
                            l.From = Vector2.new(p1.X, p1.Y)
                            l.To   = Vector2.new(p2.X, p2.Y)
                            l.Color = color
                            l.Thickness = CURRENT.LineThickness
                            l.Visible = true
                        else
                            l.Visible = false
                        end
                    end
                end
            else
                for _, l in ipairs(data.Lines) do l.Visible = false end
            end

            if mode == "Tracers" or mode == "Both" then
                if data.Tracer then
                    local mid = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    data.Tracer.From = mid
                    data.Tracer.To   = HRP2D
                    data.Tracer.Color = color
                    data.Tracer.Thickness = CURRENT.LineThickness
                    data.Tracer.Visible = true
                end
            else
                if data.Tracer then data.Tracer.Visible = false end
            end

            if mode == "Boxes" then
                local t, _ = W2D(hrp.Position + Vector3.new(0, 3, 0))
                local b, _ = W2D(hrp.Position - Vector3.new(0, 1.5, 0))
                if data.Box then
                    data.Box.Position = Vector2.new(t.X - 30, t.Y)
                    data.Box.Size     = Vector2.new(60, b.Y - t.Y)
                    data.Box.Color    = color
                    data.Box.Thickness= 1.8
                    data.Box.Visible  = true
                end
            elseif mode == "HeadDot" then
                local head = c:FindFirstChild("Head")
                if head and data.Box then
                    local h2d, ok, _ = W2D(head.Position)
                    if ok then
                        data.Box.Position = Vector2.new(h2d.X - 4, h2d.Y - 4)
                        data.Box.Size     = Vector2.new(8, 8)
                        data.Box.Color    = color
                        data.Box.Thickness= 1.5
                        data.Box.Visible  = true
                    else
                        data.Box.Visible = false
                    end
                end
            else
                if data.Box then data.Box.Visible = false end
            end

            if data.Info then
                local textParts = {}
                if CURRENT.ESP_ShowName     then table.insert(textParts, ply.Name) end
                if CURRENT.ESP_ShowDistance then table.insert(textParts, "["..math.floor(dist).." studs]") end

                if #textParts > 0 then
                    data.Info.Position = Vector2.new(HRP2D.X - 45, HRP2D.Y - 50)
                    data.Info.Text     = table.concat(textParts, " ")
                    data.Info.Color    = color
                    data.Info.Size     = 14
                    data.Info.Visible  = true
                else
                    data.Info.Visible = false
                end
            end
        end
    else
        for _, d in pairs(PlayerData) do
            for _, l in ipairs(d.Lines) do l.Visible = false end
            if d.Tracer then d.Tracer.Visible = false end
            if d.Info   then d.Info.Visible   = false end
            if d.Box    then d.Box.Visible    = false end
        end
    end

    local localChar = LocalPlayer.Character
    local localHRP  = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if localHRP then
        for _, ply in ipairs(Players:GetPlayers()) do
            if ply == LocalPlayer then continue end
            local c = ply.Character
            if not c then continue end
            local hrp = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChild("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then continue end
            local dist = (localHRP.Position - hrp.Position).Magnitude
            local state = ThreatState[ply]
            if not state then
                state = {lastRusherAlert = 0, lastAimLockAlert = 0, lastBackstabAlert = 0}
                ThreatState[ply] = state
            end

            if CURRENT.AlertRushers and dist <= CURRENT.AlertRusherDistance then
                local vel = hrp.Velocity
                if vel.Magnitude > 10 then
                    local dirToMe = (localHRP.Position - hrp.Position).Unit
                    local moveDir = vel.Unit
                    local dot = moveDir:Dot(dirToMe)
                    if dot > 0.7 and tick() - state.lastRusherAlert > 3 then
                        state.lastRusherAlert = tick()
                        ShowNotification("⚠️ RUSHER APPROACHING: "..ply.Name, "Distance "..math.floor(dist).." studs", 3)
                    end
                end
            end

            if CURRENT.AlertAimLock and dist <= CURRENT.AlertRusherDistance * 2 then
                local look = hrp.CFrame.LookVector
                local dirToMe = (localHRP.Position - hrp.Position).Unit
                local dot = look:Dot(dirToMe)
                local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
                if angle <= CURRENT.AlertAimLockAngle and tick() - state.lastAimLockAlert > 4 then
                    state.lastAimLockAlert = tick()
                    ShowNotification("⚠️ AIM-LOCK SUSPECTED: "..ply.Name, "Locked onto you", 3)
                end
            end

            if CURRENT.AlertBackstab and dist <= CURRENT.AlertBackstabDistance then
                local myLook = localHRP.CFrame.LookVector
                local dirToEnemy = (hrp.Position - localHRP.Position).Unit
                local dot = myLook:Dot(dirToEnemy)
                if dot < -0.4 and tick() - state.lastBackstabAlert > 3 then
                    state.lastBackstabAlert = tick()
                    ShowNotification("⚠️ BACKSTAB THREAT", ply.Name.." is behind you!", 3)
                end
            end
        end
    end

    if Trigger_Enabled then
        local target = Mouse.Target
        if target then
            local char = target.Parent
            local plr  = Players:GetPlayerFromCharacter(char)
            if plr and plr ~= LocalPlayer and not IsTeammate(plr) then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    if tick() - lastTriggerTime >= CURRENT.Trigger_Delay then
                        lastTriggerTime = tick()
                        pcall(mouse2press)
                        task.wait(0.02)
                        pcall(mouse2release)
                    end
                end
            end
        end
    end
end)

