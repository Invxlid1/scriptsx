UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if waitingBind and input.KeyCode ~= Enum.KeyCode.Unknown then
        local kc = input.KeyCode
        waitingBind.Button.Text = "   "..waitingBind.Label.."    "..kc.Name
        waitingBind.Set(kc)
        waitingBind = nil
        SaveSettings()
        ShowNotification("⌨️ Keybind Saved", kc.Name .. " assigned", 1.5)
        return
    end

    if input.KeyCode == KB_TRIG then
        Trigger_Enabled = not Trigger_Enabled
        CURRENT.Trigger_Enabled = Trigger_Enabled
        IX.Trigger_Enabled = Trigger_Enabled
        UpdateStatusBar()
        ShowNotification(Trigger_Enabled and "🎯 Triggerbot ON" or "🎯 Triggerbot OFF", "Key: "..KB_TRIG.Name, 2)
        SaveSettings()
    elseif input.KeyCode == KB_AIM then
        AIM_Enabled = not AIM_Enabled
        CURRENT.AIM_Enabled = AIM_Enabled
        IX.AIM_Enabled = AIM_Enabled
        UpdateStatusBar()
        ShowNotification(AIM_Enabled and "🧠 Aim Assist ON" or "🧠 Aim Assist OFF", "Key: "..KB_AIM.Name, 2)
        SaveSettings()
    elseif input.KeyCode == KB_ESP then
        ESP_Enabled = not ESP_Enabled
        CURRENT.ESP_Enabled = ESP_Enabled
        IX.ESP_Enabled = ESP_Enabled
        UpdateStatusBar()
        ShowNotification(ESP_Enabled and "🌈 ESP ON" or "🌈 ESP OFF", "Mode: "..CURRENT.ESP_Mode, 2)
        SaveSettings()
    end
end)

