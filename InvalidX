local function MakeSlider(name, value, min, max, decimals, callback, y)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 44)
    container.Position = UDim2.new(0, 0, 0, y)
    container.BackgroundTransparency = 1
    container.Parent = ContentFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamSemibold
    label.Text = "   "..name.."    "..string.format("%."..decimals.."f", value)
    label.TextColor3 = ActiveTheme.Text
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, -20, 0, 12)
    barBg.Position = UDim2.new(0, 10, 0, 24)
    barBg.BackgroundColor3 = ActiveTheme.Element
    barBg.BackgroundTransparency = 0.5
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 4)
    barBg.Parent = container

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    barFill.BackgroundColor3 = ActiveTheme.Accent
    barFill.BackgroundTransparency = 0
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 4)
    barFill.Parent = barBg

    local dragging = false
    local function UpdateFromX(x)
        local px = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
        local v = min + px * (max - min)
        v = tonumber(string.format("%."..decimals.."f", v))
        label.Text = "   "..name.."    "..string.format("%."..decimals.."f", v)
        barFill.Size = UDim2.new(px, 0, 1, 0)
        callback(v)
        SaveSettings()
    end

    barBg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            UpdateFromX(i.Position.X)
        end
    end)
    barBg.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateFromX(i.Position.X)
        end
    end)

    return container
end

